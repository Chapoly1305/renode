# Heiman HS1RM-E (EFR32 Series-1) — rehosting boot: skip un-modelable peripherals
# Goal: get the extracted app-only image to boot past init in Renode without a
# real bootloader/radio, so the RTOS + ZCL dispatch become live for frame injection.
#
# Board: brd4162a (efr32mg12, 256KB RAM) — the app's reset SP 0x2000d7d8 needs
# >53KB RAM, so the 32KB efr32mg1 board faults immediately. (Chip is Series-1:
# peripheral map 0x4000_xxxx, DEVINFO 0x0FE08000.)
#
# Progress log (each "wall" = a spin/fault the emulator can't satisfy):
#   WALL 1  MPU-guard MemManageFault loop @0x2000d920 (RTOS sets an MPU stack
#           guard; Renode mis-handles the region alignment -> infinite fault).
#           FIX: neuter the MPU set-region helper sub @0x2f294 -> `bx lr`.
#           (Safe for the vuln: the overflow writes UPWARD past SP toward the
#           caller frame, not below SP, so the stack-guard would not catch it.)
#   WALL 2  I2C "ready-bit" poll spin @0x113ae..0x113b4 (waits for
#           (reg[+0x48] & mask)==mask; Renode I2C model returns 0 forever).
#           FIX: patch the loop-back branch @0x113b4 (bne) -> nop.
#   NEXT    radio-region init (0x4007Cxxx, FRC/SYNTH/AGC/MODEM) — unmodeled;
#           expect more ready-polls here. Then the RTOS scheduler needs a tick
#           (SysTick/timer IRQ) and frame delivery still requires faking the
#           radio RX ISR + populating the EmberZNet packet-buffer pool.

mach create "heiman"
machine LoadPlatformDescription @platforms/boards/silabs/brd4162a.repl
sysbus LoadELF @/Volumes/Workspace/MatterOverwatch/vuln-reports/ZB-01_heiman_hs1rm_e/evidence/payload.elf
cpu VectorTableOffset 0x4000

# WALL 1 fix: MPU set-region helper -> bx lr (halfword 0x4770 = bytes 70 47)
sysbus WriteByte 0x2f294 0x70
sysbus WriteByte 0x2f295 0x47

# WALL 2 fix: I2C ready-poll loop-back branch @0x113b4 (d1fb bne) -> nop (bf00)
sysbus WriteByte 0x113b4 0x00
sysbus WriteByte 0x113b5 0xbf

logLevel 3
# start
