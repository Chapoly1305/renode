# Experiment: same as e2e-15.4.resc but with a 10us global quantum, to test whether the ~12ms
# device-side MAC-ACK latency (which blows the 802.15.4 864us window) is caused by coarse virtual-time
# sync granularity. If ACK latency drops below ~864us, the device should attach to the host leader.
mach create "stock"
machine LoadPlatformDescription @platforms/boards/silabs/brd2601b.repl
machine LoadPlatformDescription @matter/renode-thread/scenarios/phase3-bridges.repl
sysbus LoadELF @matter/brd2601b-matter-silabs-lighting-example.out
cpu PerformanceInMips 39
seqcpu PerformanceInMips 39
emulation CreateBLEMedium "wireless"
connector Connect sysbus.radio wireless
connector Connect sysbus.bleCentral wireless
connector Connect sysbus.ieee802154 wireless
emulation SetGlobalSerialExecution true
emulation SetGlobalAdvanceImmediately false
emulation SetGlobalQuantum "0.000010"
logFile @/tmp/renode-15.4.log true
logLevel 2
start
