// U400 bring-up stubs: return firmware-expected "success/ready" values for peripherals
// the base xG24 model only Tags (returns 0), so the door-lock's poll loops complete.

// I2C0_NS / I2C1_NS interrupt-flag register (base+0x3c = I2C_IF).
// Firmware's I2C transfer state machine (sub_803266c) polls this for:
//   ACK(0x40) | MSTOP(0x100) | RXDATAV(0x20) = 0x160  -> transfer OK, no NACK/ARBLOST/BUSERR.
i2c0_if: Python.PythonPeripheral @ sysbus 0x5B00003C
    size: 0x4
    initable: true
    script: "request.Value = 0x160"

i2c1_if: Python.PythonPeripheral @ sysbus 0x5006803C
    size: 0x4
    initable: true
    script: "request.Value = 0x160"
