# BRD2601B run with the software fake-BLE transport exposed on EUSART1.
#
# Requires a lighting-app ELF built with chip_enable_fake_ble_transport=true (see
# examples/platform/silabs/efr32/FakeBLETransport.cpp in the connectedhomeip checkout).
# The device firmware's CHIPoBLE stack is driven entirely over this socket -- no BLE
# radio/GATT emulation is involved, so `emulation CreateBLEMedium`/`connector Connect
# sysbus.radio` are intentionally omitted here.
#
# On the host, point the patched chip-tool at this port:
#   CHIP_FAKE_BLE_PORT=3500 ./chip-tool pairing ble-thread <node-id> hex:<dataset> <pin> <discriminator>

set bin @/Volumes/Tools/sl-renode/matter/brd2601b-matter-silabs-lighting-example.out

mach create "matter"
machine LoadPlatformDescription @platforms/boards/silabs/brd2601b.repl
sysbus LoadELF $bin

emulation CreateServerSocketTerminal 3500 "fake_ble_transport" false
connector Connect sysbus.eusart1 fake_ble_transport

logLevel 1

emulation SetGlobalSerialExecution true
emulation SetGlobalAdvanceImmediately true
emulation SetGlobalQuantum "0.000050"

start
