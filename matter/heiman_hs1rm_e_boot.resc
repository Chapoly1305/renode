using sysbus

mach create "heiman"
machine LoadPlatformDescription @platforms/boards/silabs/sltb001a.repl

$bin=@/Volumes/Workspace/MatterOverwatch/vuln-reports/ZB-01_heiman_hs1rm_e/evidence/payload.elf

sysbus LoadELF $bin
cpu VectorTableOffset 0x4000

emulation CreateServerSocketTerminal 3452 "cli_node1" false
connector Connect sysbus.usart0 cli_node1

logLevel 0
sysbus LogAllPeripheralsAccess true

machine StartGdbServer 3333 false cpu

start
