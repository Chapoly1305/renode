:name: ZB-02 heap init probe — call the real pool-init routine sub_140e0 and verify the boundary-tag pool
:description: Calls the firmware's own heap-pool initializer sub_140e0 after boot (it is normally run during stack bring-up, which the bare ELF skips) and verifies the inline-boundary-tag pool at 0x20005948 (size 0x2800) is populated: [0x2000456c] head set, first block header 0x0080, etc. Then allocates two blocks via sub_1411c to confirm live block placement/headers.

$bin=@scripts/silabs-vuln/zb02_aqara.elf
include @scripts/silabs-vuln/boot_mg21.resc

emulation RunFor "0.3"
pause
echo ">>> post-boot pool head [0x2000456c] (expect 0 = uninit):"
sysbus ReadDoubleWord 0x2000456c

# --- Call the real pool initializer sub_140e0 ---
sysbus.cpu SetRegister 13 0x2000FF00
sysbus.cpu SetRegister 14 0x00009001
sysbus.cpu PC 0x140e0
cpu AddHook 0x9000 "self.ErrorLog('INIT returned to sentinel')"
sysbus.cpu Step 400
echo ">>> after sub_140e0: pool head [0x2000456c] (expect 0x20005948):"
sysbus ReadDoubleWord 0x2000456c
echo ">>> pool first block header @0x20005948 (word):"
sysbus ReadDoubleWord 0x20005948
echo ">>> pool @+0x80 (0x200059c8) header:"
sysbus ReadDoubleWord 0x200059c8

# --- Allocate block A (120 bytes) ---
sysbus.cpu SetRegister 13 0x2000FF00
sysbus.cpu SetRegister 14 0x00009001
sysbus.cpu SetRegister 0  120
sysbus.cpu PC 0x1411c
sysbus.cpu Step 400
echo ">>> ALLOC A (120) ptr:"
cpu GetRegister 0

# --- Allocate block B (60 bytes) — should land right after A ---
sysbus.cpu SetRegister 13 0x2000FF00
sysbus.cpu SetRegister 14 0x00009001
sysbus.cpu SetRegister 0  60
sysbus.cpu PC 0x1411c
sysbus.cpu Step 400
echo ">>> ALLOC B (60) ptr:"
cpu GetRegister 0

quit
