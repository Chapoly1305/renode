:name: Innr SP244 natural button-path reachability probe
:description: Checks whether the unmodified firmware reaches its PA0 polling and long-press dispatch functions.

$bin=@scripts/silabs-vuln/zb03_innr.elf
include @scripts/silabs-vuln/boot_mg21.resc

# The MG21 model does not currently implement the serial storage peripheral
# used by sub_362E0. Replace that read routine in emulator RAM with
# `mov r0, r1; bx lr`, reporting that the requested byte count was consumed
# while leaving the destination's zero-initialized contents unchanged.
# The source ELF and all button/Zigbee functions remain unmodified.
sysbus WriteDoubleWord 0x362E0 0x47704608

cpu AddHook 0x331E6 "self.ErrorLog('MARK_BUTTON_POLL_331E6')"
cpu AddHook 0x2476A "self.ErrorLog('MARK_BUTTON_RELEASE_2476A r1=0x{0:X}'.format(self.GetRegister(1)))"
cpu AddHook 0x14114 "self.ErrorLog('MARK_25S_DISPATCH_14114')"
cpu AddHook 0x2955C "self.ErrorLog('MARK_FNB_INITIATOR_2955C r0=0x{0:X}'.format(self.GetRegister(0)))"

emulation RunFor "0.5"
pause
echo ">>> natural button-path probe final state"
cpu PC
cpu SP
quit
