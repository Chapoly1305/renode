:name: Aliro U400 END-TO-END producer-path LOCK chain on the REAL boot heap
:description: LOCK variant of aliro_e2e_chain.resc. Same overflow->dispatch->PRODUCER path, but the
:   command struct S names "pid_motor_lock" (0x08150584) so the producer takes its LOCK branch and
:   publishes topic "pid_motor"(0x0814f76c) payload "door_lock"(0x0814f9bc). Stage C then drives the
:   REAL consumer door_lock branch sub_807168c (0x807168c) -- NOT sub_80714f4, which is the UNLOCK-only
:   actuator. sub_807168c calls the LOCK guard sub_80713cc (0x80713cc); if it returns nonzero the code
:   reaches motor-drive sub_806da24 (0x806da24) at call-site 0x8071706 (cbz r0 => skip on 0).
:   Records every hook hit + lock-state globals to /tmp/e2e_lock.txt.
#
# State-machine sentinel @0x2000EE00. op-counter @0x2000E900.
# Command struct S=0x20024100: {+0x00 src=0, +0x04 name=0x08150584(pid_motor_lock), +0x08 len=8,
#                               +0x0C speed=0xC8, +0x10 wait=0}
# SLOT 0x2000282c := 0x08072175 (PRODUCER|thumb). VTABLE 0x20002828 stays (D_B+0x08 points to it).
# LOCK dispatch/guard map (from objdump of U400_primary_target.elf):
#   consumer sub_80718fc: door_lock match -> 0x807190e -> bl sub_807168c(r0=[msg+12])
#   sub_807168c: 0x80716fe bl sub_80713cc (LOCK guard) ; 0x8071702 cbz r0 -> skip ; 0x8071706 bl sub_806da24
#   guard sub_80713cc returns 1 at 0x8071442/0x8071446, returns 0 at 0x807143e, tail-call at 0x8071420
#   guard reads motorctx 0x2001c11c: [+0xa7]=0x2001c1c3, [+0xa6]=0x2001c1c2 ; drive ctx r0=[0x8071884]=0x2001c11c

using sysbus
emulation SetGlobalSerialExecution true
mach create "mg24"
machine LoadPlatformDescription @platforms/boards/silabs/brd4186c.repl
sysbus LoadELF @/home/chen/aliro-reassembly-audit/firmware/U400_primary_target.elf
sysbus.cpu VectorTableOffset 0x08006000

# --- overlay the REAL post-boot SRAM (restores heap + allocator control block) ---
python "import System; SB=self.Machine.SystemBus; data=System.IO.File.ReadAllBytes(\"scripts/silabs-vuln/aliro_boot_sram.bin\"); SB.WriteBytes(data, 0x20000000, False, None); System.Console.WriteLine(\"OVERLAY restored {0} bytes; tail-base now 0x{1:X}\".format(len(data), SB.ReadDoubleWord(0x20012894)))"

# fresh log file
python "import System; System.IO.File.WriteAllText('/tmp/e2e_lock.txt','=== ALIRO E2E PRODUCER-PATH LOCK CHAIN ===\n')"

# --- stubs: loggers + FreeRTOS transfer-list lock gate (same as chain) ---
sysbus WriteWord 0x8033598 0x4770
sysbus WriteWord 0x80336f0 0x4770
sysbus WriteWord 0x80cae30 0x4770
sysbus WriteDoubleWord 0x801e0f8 0x47702001
sysbus WriteWord 0x801e124 0x4770
sysbus WriteWord 0x801e114 0x4770
sysbus WriteWord 0x801df64 0x2000
sysbus WriteWord 0x801df66 0x4770
# NEUTRALIZE the FreeRTOS configASSERT-fail trap (emulation artifact, identical to unlock harness).
sysbus WriteWord 0x80348c4 0x2000
sysbus WriteWord 0x80348c6 0x4770
# Enable FPU (CP10/CP11). Partial boot never set CPACR. Emulation artifact.
sysbus.cpu FpuEnabled true
sysbus.cpu CPACR 0x00F00000
sysbus WriteWord 0x2000EE00 0xE7FE
sysbus WriteWord 0x2000EF00 0xE7FE
# returnable NOP stub for the "setup-only" op3 (bx lr back to sentinel)
sysbus WriteWord 0x2000EF10 0x4770
sysbus WriteDoubleWord 0x2000E900 0x00000000
# on_data memcpy source (0x41 fill) - low RAM, outside heap
sysbus WriteDoubleWord 0x2000EA00 0x41414141
sysbus WriteDoubleWord 0x2000EA04 0x41414141
sysbus WriteDoubleWord 0x2000EA08 0x41414141
sysbus WriteDoubleWord 0x2000EA0C 0x41414141

$sdu?=0x40
sysbus WriteDoubleWord 0x2000E8F0 $sdu

# ---------------------------------------------------------------------------
# STATE MACHINE sentinel @0x2000EE00  (only change vs unlock: S+0x04 name = 0x08150584)
# ---------------------------------------------------------------------------
sysbus.cpu AddHook 0x2000EE00 "from Antmicro.Renode.Peripherals.CPU import RegisterValue as R; import System; B=self.Bus; o=B.ReadDoubleWord(0x2000E900); sdu=B.ReadDoubleWord(0x2000E8F0); DA=B.ReadDoubleWord(0x2001b758); DB=B.ReadDoubleWord(0x2001b75c); s=(o==3 and DB!=0); z1=(B.WriteWord(DA+0x12,sdu) if (o==1 and DA) else 0); w0=(B.WriteDoubleWord(0x20024100,0) if s else 0); w1=(B.WriteDoubleWord(0x20024104,0x08150584) if s else 0); w2=(B.WriteDoubleWord(0x20024108,8) if s else 0); w3=(B.WriteDoubleWord(0x2002410C,0xC8) if s else 0); w4=(B.WriteDoubleWord(0x20024110,0) if s else 0); w5=(B.WriteDoubleWord(0x2000282c,0x08072175) if s else 0); w6=(B.WriteDoubleWord(DB+0x00,2) if s else 0); w7=(B.WriteDoubleWord(DB+0x08,0x20002828) if s else 0); w8=(B.WriteWord(DB+0x0c,0x00AA) if s else 0); w9=(B.WriteDoubleWord(DB+0x20,0x20024100) if s else 0); wA=(B.WriteDoubleWord(DB+0x24,0) if s else 0); wB=(B.WriteDoubleWord(DB+0x28,2) if s else 0); wC=(B.WriteDoubleWord(DB+0x38,0x2000282c) if s else 0); wD=(B.WriteDoubleWord(DB+0x04,0) if s else 0); wE=(B.WriteDoubleWord(0x20013878,DB+0x04) if s else 0); wF=(B.WriteDoubleWord(0x2001c210,0) if s else 0); wG=(B.WriteDoubleWord(0x20024088,0) if s else 0); r0c=(B.WriteDoubleWord(0x2000EB00,DA) if s else 0); r1c=(B.WriteDoubleWord(0x2000EB04,B.ReadDoubleWord(DA+0x38)) if s else 0); r2c=(B.WriteDoubleWord(0x2000EB08,DB) if s else 0); f0=(B.WriteByte(0x2000EF80,2) if s else 0); f1=(B.WriteWord(0x2000EF81,0x00AA) if s else 0); f2=(B.WriteByte(0x2000EF83,0x06) if s else 0); f3=(B.WriteWord(0x2000EF84,sdu) if s else 0); f4=(B.WriteDoubleWord(0x2000EF86,0x42424242) if s else 0); lg=(System.IO.File.AppendAllText('/tmp/e2e_lock.txt','STAGE_A setup: S name=0x{0:X} len={1} speed={2} SLOT=0x{3:X} DB+0x08=0x{4:X} DB+0x20=0x{5:X} DB+0x0c=0x{6:X} DB+0x28=0x{7:X} listhead=0x{8:X}(->DB+4=0x{9:X})\n'.format(B.ReadDoubleWord(0x20024104),B.ReadDoubleWord(0x20024108),B.ReadDoubleWord(0x2002410C),B.ReadDoubleWord(0x2000282c),B.ReadDoubleWord(DB+0x08),B.ReadDoubleWord(DB+0x20),B.ReadWord(DB+0x0c),B.ReadDoubleWord(DB+0x28),B.ReadDoubleWord(0x20013878),DB+4)) if s else 0); seq=[(0x805e9c8,1,0,0,0),(0x805e7b0,DA+4,0,0x10,0x2000EA00),(0x805e9c8,2,0,0,0),(0x2000EF10,0,0,0,0),(0x801d96c,0x2000EF80,0,0,0),(0x807168c,0x2001c11c,0,0,0),(0,0,0,0,0)]; t=seq[o] if o<len(seq) else (0,0,0,0,0); a=t[0]; B.WriteDoubleWord(0x2000E900,o+1); self.SetRegister(0,R.Create(t[1],32)); self.SetRegister(1,R.Create(t[2],32)); self.SetRegister(2,R.Create(t[3],32)); self.SetRegister(3,R.Create(t[4],32)); self.SetRegister(13,R.Create(0x2003F000,32)); self.SetRegister(14,R.Create(0x2000EE01,32)); self.SetRegister(15,R.Create(a if a else 0x2000EF00,32))"

# ---------------------------------------------------------------------------
# STAGE A observation hooks
# ---------------------------------------------------------------------------
sysbus.cpu AddHook 0x805e5fc "import System; System.IO.File.AppendAllText('/tmp/e2e_lock.txt','CREATE_DESC conn={0}\n'.format(self.GetRegister(0).RawValue))"
sysbus.cpu AddHook 0x805e838 "import System; System.IO.File.AppendAllText('/tmp/e2e_lock.txt','MEMCPY dst=0x{0:X} src=0x{1:X} len={2}\n'.format(self.GetRegister(0).RawValue, self.GetRegister(1).RawValue, self.GetRegister(2).RawValue))"
sysbus.cpu AddHook 0x801d96c "import System; System.IO.File.AppendAllText('/tmp/e2e_lock.txt','RX_HANDLER sub_801d96c frame=0x{0:X} conn={1} cid=0x{2:X} datalen={3}\n'.format(self.GetRegister(0).RawValue, self.Bus.ReadByte(self.GetRegister(0).RawValue), self.Bus.ReadWord(self.GetRegister(0).RawValue+1), self.Bus.ReadByte(self.GetRegister(0).RawValue+3)))"
sysbus.cpu AddHook 0x801d980 "import System; System.IO.File.AppendAllText('/tmp/e2e_lock.txt','  FIND_TRANSFER ret=0x{0:X}\n'.format(self.GetRegister(0).RawValue))"
sysbus.cpu AddHook 0x801d9be "import System; System.IO.File.AppendAllText('/tmp/e2e_lock.txt','  DISPATCH_BLX r7(target)=0x{0:X} r0=0x{1:X} r1=0x{2:X} r2(len)=0x{3:X}\n'.format(self.GetRegister(7).RawValue, self.GetRegister(0).RawValue, self.GetRegister(1).RawValue, self.GetRegister(2).RawValue))"

# PRODUCER entry
sysbus.cpu AddHook 0x8072174 "import System; System.IO.File.AppendAllText('/tmp/e2e_lock.txt','*** STAGE_A REACHED PRODUCER sub_8072174  r0=0x{0:X} r1(cmd)=0x{1:X} | cmd.name_ptr=0x{2:X} cmd.len={3} cmd.speed={4}\n'.format(self.GetRegister(0).RawValue, self.GetRegister(1).RawValue, self.Bus.ReadDoubleWord(self.GetRegister(1).RawValue+4), self.Bus.ReadDoubleWord(self.GetRegister(1).RawValue+8), self.Bus.ReadDoubleWord(self.GetRegister(1).RawValue+0x0c)))"
# LOCK branch entry (0x80724b2 = producer takes lock family after unlock-strcmp fails)
sysbus.cpu AddHook 0x80724b2 "import System; System.IO.File.AppendAllText('/tmp/e2e_lock.txt','   prod: LOCK-FAMILY branch 0x80724b2 entered (unlock strcmp failed as expected)\n')"
sysbus.cpu AddHook 0x807253e "import System; System.IO.File.AppendAllText('/tmp/e2e_lock.txt','   prod: LOCK matched pid_motor_lock -> door_lock publish path 0x807253e\n')"
sysbus.cpu AddHook 0x806f0a4 "import System; System.IO.File.AppendAllText('/tmp/e2e_lock.txt','   prod: sub_806f0a4 (r6 source)\n')"
sysbus.cpu AddHook 0x81250fa "import System; System.IO.File.AppendAllText('/tmp/e2e_lock.txt','   prod: name-match sub_81250fa r0(name)=0x{0:X} r1(count)={1} r2(tbl)=0x{2:X}\n'.format(self.GetRegister(0).RawValue,self.GetRegister(1).RawValue,self.GetRegister(2).RawValue))"
sysbus.cpu AddHook 0x80e2dd0 "import System; System.IO.File.AppendAllText('/tmp/e2e_lock.txt','   prod: rtos sub_80e2dd0 (tick)\n')"
# TRAP catcher (infinite-spin fault handler): dump the stacked exception frame (faulting PC)
sysbus.cpu AddHook 0x80D4904 "import System; B=self.Bus; sp=self.GetRegister(13).RawValue; System.IO.File.AppendAllText('/tmp/e2e_lock.txt','!!! HIT TRAP-SPIN 0x080D4904 LR=0x{0:X} SP=0x{1:X} | frame r0=0x{2:X} r1=0x{3:X} r2=0x{4:X} r3=0x{5:X} r12=0x{6:X} exLR=0x{7:X} exPC=0x{8:X} xPSR=0x{9:X}\n'.format(self.GetRegister(14).RawValue, sp, B.ReadDoubleWord(sp), B.ReadDoubleWord(sp+4), B.ReadDoubleWord(sp+8), B.ReadDoubleWord(sp+12), B.ReadDoubleWord(sp+16), B.ReadDoubleWord(sp+20), B.ReadDoubleWord(sp+24), B.ReadDoubleWord(sp+28)))"

# ---------------------------------------------------------------------------
# STAGE B hooks: accept + publish (LOCK: expect payload=door_lock 0x0814f9bc)
# ---------------------------------------------------------------------------
sysbus.cpu AddHook 0x8072118 "import System; System.IO.File.AppendAllText('/tmp/e2e_lock.txt','+++ STAGE_B ACCEPT sub_8072118 r0(str)=0x{0:X}\n'.format(self.GetRegister(0).RawValue))"
sysbus.cpu AddHook 0x80c8f68 "import System; B=self.Bus; p=self.GetRegister(1).RawValue; pb=''.join([chr(B.ReadByte(p+i)) for i in range(9)]); System.IO.File.AppendAllText('/tmp/e2e_lock.txt','+++ STAGE_B PUBLISH sub_80c8f68 topic=0x{0:X} payload=0x{1:X} payload_str=\"{2}\" r2=0x{3:X} len=0x{4:X}\n'.format(self.GetRegister(0).RawValue, p, pb, self.GetRegister(2).RawValue, self.GetRegister(3).RawValue))"
sysbus.cpu AddHook 0x80c8bcc "import System; System.IO.File.AppendAllText('/tmp/e2e_lock.txt','    publish: find-subscriber sub_80c8bcc topic=0x{0:X}\n'.format(self.GetRegister(0).RawValue))"
sysbus.cpu AddHook 0x80c8d7c "import System; System.IO.File.AppendAllText('/tmp/e2e_lock.txt','    publish: alloc-msg-node sub_80c8d7c (subscriber FOUND, enqueue path)\n')"
sysbus.cpu AddHook 0x8124e86 "import System; System.IO.File.AppendAllText('/tmp/e2e_lock.txt','    publish: ENQUEUE sub_8124e86 queue=0x{0:X} node=0x{1:X}\n'.format(self.GetRegister(0).RawValue, self.GetRegister(1).RawValue))"
sysbus.cpu AddHook 0x8034efc "import System; System.IO.File.AppendAllText('/tmp/e2e_lock.txt','    publish: SEM_GIVE sub_8034efc sem=0x{0:X}\n'.format(self.GetRegister(0).RawValue))"
sysbus.cpu AddHook 0x80c0e78 "import System; System.IO.File.AppendAllText('/tmp/e2e_lock.txt','    post-publish sub_80c0e78 r0=0x{0:X} r1=0x{1:X} (survived publish)\n'.format(self.GetRegister(0).RawValue, self.GetRegister(1).RawValue))"
sysbus.cpu AddHook 0x80c122c "import System; System.IO.File.AppendAllText('/tmp/e2e_lock.txt','    post-publish sub_80c122c r0=0x{0:X} r1=0x{1:X}\n'.format(self.GetRegister(0).RawValue, self.GetRegister(1).RawValue))"

# When the LOCK producer finishes (0x8072606 -> b 0x8072538, the door_lock publish tail; and the
# shared epilogue 0x807229e for the unlock tail is NOT taken on lock). We hand off to STAGE C at the
# lock-path post-publish return 0x8072606 (right after sub_80c122c): drive the REAL consumer door_lock
# branch sub_807168c(r0=0x2001c11c motor-ctx) exactly as the consumer task would after dequeuing the
# "door_lock" message we just enqueued. Bump op-counter past op5 so the eventual return ends cleanly.
sysbus.cpu AddHook 0x8072606 "from Antmicro.Renode.Peripherals.CPU import RegisterValue as R; import System; B=self.Bus; System.IO.File.AppendAllText('/tmp/e2e_lock.txt','=== LOCK producer complete -> hand off to STAGE C (drive door_lock consumer branch sub_807168c) | PRE-CALL lockstate 0x2001c1c0={0} 0x2001c1c1={1} 0x2001c1c2={2} 0x2001c1c3={3} | motorctx[+0xa6]={4} [+0xa7]={5}\n'.format(B.ReadByte(0x2001c1c0),B.ReadByte(0x2001c1c1),B.ReadByte(0x2001c1c2),B.ReadByte(0x2001c1c3),B.ReadByte(0x2001c11c+0xa6),B.ReadByte(0x2001c11c+0xa7))); B.WriteDoubleWord(0x2000E900,6); self.SetRegister(0,R.Create(0x2001c11c,32)); self.SetRegister(1,R.Create(0,32)); self.SetRegister(13,R.Create(0x2003F000,32)); self.SetRegister(14,R.Create(0x2000EE01,32)); self.SetRegister(15,R.Create(0x0807168c,32))"

# ---------------------------------------------------------------------------
# STAGE C hooks: consumer-side LOCK actuation (door_lock branch sub_807168c)
# ---------------------------------------------------------------------------
# door_lock consumer branch entry
sysbus.cpu AddHook 0x807168c "import System; B=self.Bus; System.IO.File.AppendAllText('/tmp/e2e_lock.txt','### STAGE_C LOCK-BRANCH sub_807168c r0(ctx)=0x{0:X} | lockstate 0x2001c1c0={1} 0x2001c1c1={2} 0x2001c1c2={3} 0x2001c1c3={4} | motorctx@0x2001c11c +0xa4={5} +0xa5={6} +0xa6={7} +0xa7={8}\n'.format(self.GetRegister(0).RawValue, B.ReadByte(0x2001c1c0), B.ReadByte(0x2001c1c1), B.ReadByte(0x2001c1c2), B.ReadByte(0x2001c1c3), B.ReadByte(0x2001c11c+0xa4), B.ReadByte(0x2001c11c+0xa5), B.ReadByte(0x2001c11c+0xa6), B.ReadByte(0x2001c11c+0xa7)))"
# LOCK guard sub_80713cc (the symmetric 'already locked?' check)
sysbus.cpu AddHook 0x80713cc "import System; B=self.Bus; System.IO.File.AppendAllText('/tmp/e2e_lock.txt','### STAGE_C LOCK-GUARD sub_80713cc entered | reads motorctx[+0xa7]=0x2001c1c3={0} [+0xa6]=0x2001c1c2={1}\n'.format(B.ReadByte(0x2001c1c3), B.ReadByte(0x2001c1c2)))"
# guard return sites: 0x8071442 ret=1 (elapsed<threshold), 0x8071446 ret=1 (pos within tol), 0x807143e ret=0 (pos moved > tol)
sysbus.cpu AddHook 0x8071442 "import System; System.IO.File.AppendAllText('/tmp/e2e_lock.txt','    LOCK-GUARD -> return 1 (0x8071442: elapsed<threshold => PROCEED to motor)\n')"
sysbus.cpu AddHook 0x8071446 "import System; System.IO.File.AppendAllText('/tmp/e2e_lock.txt','    LOCK-GUARD -> return 1 (0x8071446: pos within tolerance => PROCEED to motor)\n')"
sysbus.cpu AddHook 0x807143e "import System; System.IO.File.AppendAllText('/tmp/e2e_lock.txt','    LOCK-GUARD -> return 0 (0x807143e: pos delta > 226 => SKIP motor / already-locked)\n')"
sysbus.cpu AddHook 0x807140a "import System; System.IO.File.AppendAllText('/tmp/e2e_lock.txt','    LOCK-GUARD tail-branch 0x807140a ([+0xa7]!=[+0xa6]) -> sub_80ecdfa tail-call (result=return)\n')"
sysbus.cpu AddHook 0x8071420 "import System; System.IO.File.AppendAllText('/tmp/e2e_lock.txt','    LOCK-GUARD RETURN r0={0}\n'.format(self.GetRegister(0).RawValue))"
# drive decision site + actual motor drive
sysbus.cpu AddHook 0x8071702 "import System; System.IO.File.AppendAllText('/tmp/e2e_lock.txt','### STAGE_C guard-result at 0x8071702 (cbz r0->skip): r0={0} => {1}\n'.format(self.GetRegister(0).RawValue, 'PROCEED to sub_806da24' if self.GetRegister(0).RawValue!=0 else 'SKIP motor (guard blocked)'))"
sysbus.cpu AddHook 0x8071706 "import System; System.IO.File.AppendAllText('/tmp/e2e_lock.txt','#### STAGE_C ***MOTOR DRIVE call-site 0x8071706 (bl sub_806da24) REACHED*** r0(ctx)=0x{0:X}\n'.format(self.GetRegister(0).RawValue))"
sysbus.cpu AddHook 0x806da24 "import System; System.IO.File.AppendAllText('/tmp/e2e_lock.txt','#### STAGE_C ***INSIDE sub_806da24 MOTOR-DRIVE*** r0=0x{0:X} r1=0x{1:X}\n'.format(self.GetRegister(0).RawValue, self.GetRegister(1).RawValue))"
sysbus.cpu AddHook 0x8071710 "import System; System.IO.File.AppendAllText('/tmp/e2e_lock.txt','    STAGE_C post-guard 0x8071710 reached (skip-path or drive-returned path)\n')"

sysbus.cpu SetRegister 13 0x2003F000
sysbus.cpu SetRegister 14 0x2000EE01
sysbus.cpu SetRegister 0 0
sysbus.cpu PC 0x2000EE00
sysbus.cpu Step 9000000

echo "==================== STAGE A/B/C LOCK RESULT ===================="
python "import System; SB=self.Machine.SystemBus; System.Console.WriteLine('final op counter={0}'.format(SB.ReadDoubleWord(0x2000E900)))"
echo ">>> D_A / B1 / D_B:"
sysbus ReadDoubleWord 0x2000EB00
sysbus ReadDoubleWord 0x2000EB04
sysbus ReadDoubleWord 0x2000EB08
echo ">>> SLOT 0x2000282c (expect 0x08072175):"
sysbus ReadDoubleWord 0x2000282c
echo ">>> lock-state globals 0x2001c1c0/c1/c2/c3:"
sysbus ReadByte 0x2001c1c0
sysbus ReadByte 0x2001c1c1
sysbus ReadByte 0x2001c1c2
sysbus ReadByte 0x2001c1c3
echo ">>> ---- /tmp/e2e_lock.txt (Stage A/B/C log) ----"
python "import System; System.Console.Write(System.IO.File.ReadAllText('/tmp/e2e_lock.txt'))"
quit
