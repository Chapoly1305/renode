:name: OBJ1 mbus subscriber list walk
using sysbus
emulation SetGlobalSerialExecution true
mach create "mg24"
machine LoadPlatformDescription @platforms/boards/silabs/brd4186c.repl
sysbus LoadELF @/home/chen/aliro-reassembly-audit/firmware/U400_primary_target.elf
sysbus.cpu VectorTableOffset 0x08006000
python "import System; SB=self.Machine.SystemBus; data=System.IO.File.ReadAllBytes(\"scripts/silabs-vuln/aliro_boot_sram.bin\"); SB.WriteBytes(data, 0x20000000, False, None); System.Console.WriteLine(\"OVERLAY restored {0} bytes\".format(len(data)))"
python "execfile(\"/tmp/obj1_walk.py\")"
quit
