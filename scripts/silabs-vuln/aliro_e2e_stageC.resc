:name: Aliro U400 E2E Stage C — consumer-side motor actuation on the REAL boot heap
:description: Companion to aliro_e2e_chain.resc (which proves Stage A reach-producer + Stage B publish
: "door_unlock" -> mbus enqueue + sem-give). Stage C directly drives the exact call the consumer task
: sub_80718fc makes when it dequeues a "door_unlock" message: sub_80714f4(r0=speed=0xC8, r1=wait=0).
: Records whether the "already-unlocked" guard sub_8070818 blocks, and whether the real motor drive
: sub_806da24 is reached, plus the lock-state / motor-ctx globals (to distinguish a genuine gate from
: a partial-boot artifact).
#
# Same fresh-machine + SRAM-overlay pattern. Single direct call via a sentinel at 0x2000EE00.

using sysbus
emulation SetGlobalSerialExecution true
mach create "mg24"
machine LoadPlatformDescription @platforms/boards/silabs/brd4186c.repl
sysbus LoadELF @/home/chen/aliro-reassembly-audit/firmware/U400_primary_target.elf
sysbus.cpu VectorTableOffset 0x08006000

python "import System; SB=self.Machine.SystemBus; data=System.IO.File.ReadAllBytes(\"/home/chen/matter-renode-work/sl-renode/scripts/silabs-vuln/aliro_boot_sram.bin\"); SB.WriteBytes(data, 0x20000000, False, None); System.Console.WriteLine(\"OVERLAY restored {0} bytes\".format(len(data)))"

python "import System; System.IO.File.WriteAllText('/tmp/e2e_c.txt','=== ALIRO E2E STAGE C (consumer motor actuation) ===\n')"

# loggers + assert-trap neutralized (same emulation-artifact bypass as chain script)
sysbus WriteWord 0x8033598 0x4770
sysbus WriteWord 0x80336f0 0x4770
sysbus WriteWord 0x80cae30 0x4770
sysbus WriteWord 0x80348c4 0x2000
sysbus WriteWord 0x80348c6 0x4770
sysbus WriteWord 0x2000EE00 0xE7FE
# Enable the FPU (CP10/CP11 full access). The partial boot never ran the startup code that
# sets CPACR, so FPU (vmov/vcvt) ops fault -> fault-spin. Emulation artifact; a fully-booted
# device enables the FPU during reset. Use the CortexM model's FpuEnabled + CPACR.
sysbus.cpu FpuEnabled true
sysbus.cpu CPACR 0x00F00000
sysbus WriteDoubleWord 0xE000ED88 0x00F00000

# Log dump of lock-state / motor-ctx globals BEFORE the call
python "import System; B=self.Machine.SystemBus; m='PRE-CALL globals: 0x2001c1c0={0} 0x2001c1c1={1} 0x2001c1c3={2} | motorctx@0x2001c11c +0x51={3} +0x60={4} +0x61={5} +0xa4={6} +0xa7={7} | GBUSY 0x2001c210={8} GMOVING 0x20024088={9}\n'.format(B.ReadByte(0x2001c1c0),B.ReadByte(0x2001c1c1),B.ReadByte(0x2001c1c3),B.ReadByte(0x2001c11c+0x51),B.ReadByte(0x2001c11c+0x60),B.ReadByte(0x2001c11c+0x61),B.ReadByte(0x2001c11c+0xa4),B.ReadByte(0x2001c11c+0xa7),B.ReadDoubleWord(0x2001c210),B.ReadDoubleWord(0x20024088)); System.IO.File.AppendAllText('/tmp/e2e_c.txt',m)"

# Stage C hooks
sysbus.cpu AddHook 0x80714f4 "import System; B=self.Bus; System.IO.File.AppendAllText('/tmp/e2e_c.txt','### MOTOR-ACTUATOR sub_80714f4 r0(speed)=0x{0:X} r1(wait)=0x{1:X}\n'.format(self.GetRegister(0).RawValue, self.GetRegister(1).RawValue))"
# early subcalls in sub_80714f4 (find which one BusFaults under partial boot)
sysbus.cpu AddHook 0x80ec2da "import System; System.IO.File.AppendAllText('/tmp/e2e_c.txt','    sub_80ec2da (telemetry ts)\n')"
sysbus.cpu AddHook 0x80e1cf8 "import System; System.IO.File.AppendAllText('/tmp/e2e_c.txt','    sub_80e1cf8\n')"
sysbus.cpu AddHook 0x8064b5c "import System; System.IO.File.AppendAllText('/tmp/e2e_c.txt','    sub_8064b5c (log)\n')"
sysbus.cpu AddHook 0x806e788 "import System; System.IO.File.AppendAllText('/tmp/e2e_c.txt','    sub_806e788\n')"
# fault-handler catcher: dump stacked exception frame (faulting PC)
sysbus.cpu AddHook 0x80D4904 "import System; B=self.Bus; sp=self.GetRegister(13).RawValue; System.IO.File.AppendAllText('/tmp/e2e_c.txt','!!! FAULT-SPIN 0x080D4904 LR=0x{0:X} SP=0x{1:X} exPC=0x{2:X} exLR=0x{3:X} r0=0x{4:X} r1=0x{5:X} r2=0x{6:X}\n'.format(self.GetRegister(14).RawValue, sp, B.ReadDoubleWord(sp+24), B.ReadDoubleWord(sp+20), B.ReadDoubleWord(sp), B.ReadDoubleWord(sp+4), B.ReadDoubleWord(sp+8)))"
sysbus.cpu AddHook 0x8070818 "import System; System.IO.File.AppendAllText('/tmp/e2e_c.txt','### GUARD sub_8070818 (already-unlocked?) entered\n')"
sysbus.cpu AddHook 0x8070846 "import System; System.IO.File.AppendAllText('/tmp/e2e_c.txt','    guard -> return 1 (+0x61 set) ALREADY-UNLOCKED\n')"
sysbus.cpu AddHook 0x807084a "import System; System.IO.File.AppendAllText('/tmp/e2e_c.txt','    guard -> return 1 (+0x60 set) ALREADY-UNLOCKED\n')"
sysbus.cpu AddHook 0x807084e "import System; System.IO.File.AppendAllText('/tmp/e2e_c.txt','    guard -> return 1 (i1 +0x60 set) ALREADY-UNLOCKED\n')"
sysbus.cpu AddHook 0x8070844 "import System; System.IO.File.AppendAllText('/tmp/e2e_c.txt','    guard -> return 0 => NOT already-unlocked (PROCEED to motor)\n')"
sysbus.cpu AddHook 0x807071c "import System; System.IO.File.AppendAllText('/tmp/e2e_c.txt','    sub_807071c (guard==0 proceed helper)\n')"
sysbus.cpu AddHook 0x8071458 "import System; System.IO.File.AppendAllText('/tmp/e2e_c.txt','    pre-drive gate sub_8071458 r0=0x{0:X}\n'.format(self.GetRegister(0).RawValue))"
sysbus.cpu AddHook 0x8071546 "import System; System.IO.File.AppendAllText('/tmp/e2e_c.txt','#### ***MOTOR DRIVE call-site 0x8071546 (bl sub_806da24) REACHED*** r0=0x{0:X}\n'.format(self.GetRegister(0).RawValue))"
sysbus.cpu AddHook 0x806da24 "import System; System.IO.File.AppendAllText('/tmp/e2e_c.txt','#### ***INSIDE sub_806da24 MOTOR-DRIVE*** r0=0x{0:X} r1=0x{1:X}\n'.format(self.GetRegister(0).RawValue, self.GetRegister(1).RawValue))"
sysbus.cpu AddHook 0x807158a "import System; System.IO.File.AppendAllText('/tmp/e2e_c.txt','    guard==0 branch: sub_807071c then drive-loop\n')"
sysbus.cpu AddHook 0x807152a "import System; System.IO.File.AppendAllText('/tmp/e2e_c.txt','    reached drive-loop head 0x807152a\n')"
sysbus.cpu AddHook 0x8071608 "import System; System.IO.File.AppendAllText('/tmp/e2e_c.txt','### sub_80714f4 RETURN r4(result)=0x{0:X}\n'.format(self.GetRegister(4).RawValue))"

# direct call sub_80714f4(0xC8, 0) with LR trap at sentinel
sysbus.cpu SetRegister 0 0xC8
sysbus.cpu SetRegister 1 0
sysbus.cpu SetRegister 13 0x2003F000
sysbus.cpu SetRegister 14 0x2000EE01
sysbus.cpu PC 0x080714f4
sysbus.cpu Step 4000000

echo "==================== STAGE C RESULT ===================="
python "import System; System.Console.Write(System.IO.File.ReadAllText('/tmp/e2e_c.txt'))"
quit
