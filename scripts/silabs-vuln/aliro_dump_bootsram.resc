using sysbus
emulation SetGlobalSerialExecution true
mach create "mg24"
machine LoadPlatformDescription @platforms/boards/silabs/brd4186c.repl
sysbus LoadELF @/home/chen/aliro-reassembly-audit/firmware/U400_primary_target.elf
sysbus.cpu VectorTableOffset 0x08006000
sysbus WriteWord 0x808105c 0xe004
sysbus WriteWord 0x80e3e46 0x2000
sysbus WriteWord 0x80e3e48 0x4770
sysbus WriteWord 0x80e3e56 0x2000
sysbus WriteWord 0x80e3e58 0x4770
sysbus WriteWord 0x80e3e86 0x2000
sysbus WriteWord 0x80e3e88 0x4770
sysbus WriteWord 0x80e3e96 0x2000
sysbus WriteWord 0x80e3e98 0x4770
sysbus WriteWord 0x80e3ea6 0x2000
sysbus WriteWord 0x80e3ea8 0x4770
emulation RunFor "4.0"
pause
echo "=== tail-base ==="
sysbus ReadDoubleWord 0x20012894
python "import System; SB=self.Machine.SystemBus; data=SB.ReadBytes(0x20000000, 0x40000); System.IO.File.WriteAllBytes(\"/home/chen/matter-renode-work/sl-renode/scripts/silabs-vuln/aliro_boot_sram.bin\", data); System.Console.WriteLine(\"DUMPED {0} bytes\".format(len(data)))"
