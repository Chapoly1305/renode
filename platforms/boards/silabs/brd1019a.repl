using "platforms/cpus/silabs/sixG30x/sixG301.repl"

led0: Miscellaneous.LED @ gpioPort 50  // PD02

led1: Miscellaneous.LED @ gpioPort 51  // PD03

gpioPort:
    50 -> led0@0
    51 -> led1@0

button0: Miscellaneous.Button @ gpioPort 17  // PB01
    -> gpioPort@17

button1: Miscellaneous.Button @ gpioPort 37  // PC05
    -> gpioPort@37

sram:
    size: 0x80000

flash:
    size: 0x400000

semailbox:
    flashSize: 0x400000
    flashPageSize: 0x1000    
    flashRegionSize: 0x8000
    flashCodeRegionStart: 0x30000 // Starts after SE area, which is 192kB for Rainier
    flashCodeRegionEnd: 0x1E7FFF // Initial code region end address: (flashSize - codeRegionStart)/2
    flashDataRegionStart: 0x1E8000 // Initial start of data portion

//--------------------------------
// Crystal frequency configuration
//--------------------------------

nvic:
    systickFrequency: 38400000

radio:
    clockFrequency: 38400000

seqacc:
    frequency: 38400000

eusart0:
    clockFrequency: 38400000

eusart1:
    clockFrequency: 38400000

eusart2:
    clockFrequency: 38400000

timer0:
    frequency: 38400000

timer1:
    frequency: 38400000

timer2:
    frequency: 38400000

timer3:
    frequency: 38400000

wtimer0:
    frequency: 38400000

wtimer1:
    frequency: 38400000