using "platforms/cpus/silabs/efr32s2/efr32xG26.repl"

led0: Miscellaneous.LED @ gpioPort 18  // PB02

led1: Miscellaneous.LED @ gpioPort 20  // PB04

gpioPort:
    18 -> led0@0
    20 -> led1@0

button0: Miscellaneous.Button @ gpioPort 17  // PB01
    -> gpioPort@17

button1: Miscellaneous.Button @ gpioPort 19  // PB03
    -> gpioPort@19

deviceInformation:
    deviceNumber: 1410

radio:
    pa0DbmSupport: true
    pa10DbmSupport: true
    pa20DbmSupport: false

sram:
    size: 0x80000

flash:
    size: 0x31E000

lockbitsdata: Miscellaneous.SiLabs.SiLabs_LockbitsData @ sysbus 0x0831E000
    size: 0x2000

msc:
    flashSize: 0x320000
    flashPageSize: 0x2000

//--------------------------------
// Crystal frequency configuration
//--------------------------------

nvic:
    systickFrequency: 39000000

radio:
    clockFrequency: 39000000

usart0:
    clockFrequency: 39000000

eusart0:
    clockFrequency: 39000000

eusart1:
    clockFrequency: 39000000

timer0:
    frequency: 39000000

timer1:
    frequency: 39000000

timer2:
    frequency: 39000000

timer3:
    frequency: 39000000

timer4:
    frequency: 39000000

timer5:
    frequency: 39000000

timer6:
    frequency: 39000000

timer7:
    frequency: 39000000

timer8:
    frequency: 39000000

timer9:
    frequency: 39000000

wtimer0:
    frequency: 39000000

wtimer1:
    frequency: 39000000
