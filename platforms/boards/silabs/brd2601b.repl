// BRD2601B / xG24-DK2601B — EFR32MG24B310F1536IM48 Dev Kit
// RGB LED (active low): R=PD02, G=PA04, B=PB00
// Push buttons (active low): BTN0=PB02, BTN1=PB03
using "platforms/cpus/silabs/efr32s2/efr32xG24.repl"

led0: Miscellaneous.LED @ gpioPort 4   // PA04 - green
led1: Miscellaneous.LED @ gpioPort 16  // PB00 - blue
led2: Miscellaneous.LED @ gpioPort 50  // PD02 - red

gpioPort:
    4 -> led0@0
    16 -> led1@0
    50 -> led2@0

button0: Miscellaneous.Button @ gpioPort 18  // PB02
    -> gpioPort@18

button1: Miscellaneous.Button @ gpioPort 19  // PB03
    -> gpioPort@19

deviceInformation:
    deviceNumber: 1310

radio:
    pa0DbmSupport: true
    pa10DbmSupport: true
    pa20DbmSupport: false
    clockFrequency: 39000000

sram:
    size: 0x40000

flash:
    size: 0x17E000

lockbitsdata: Miscellaneous.SiLabs.SiLabs_LockbitsData @ sysbus 0x0817E000
    size: 0x2000

msc:
    flashSize: 0x180000
    flashPageSize: 0x2000

//--------------------------------
// Crystal frequency configuration
//--------------------------------

nvic:
    systickFrequency: 39000000

usart0:
    clockFrequency: 39000000

eusart0:
    clockFrequency: 39000000

eusart1:
    clockFrequency: 39000000

timer0:
    frequency: 39000000

timer1:
    frequency: 39000000

wtimer0:
    frequency: 39000000

wtimer1:
    frequency: 39000000
